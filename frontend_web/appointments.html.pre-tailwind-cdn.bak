<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>المواعيد اليومية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        @keyframes toastIn {
            0% { opacity: 0; transform: translate(-50%, -16px) scale(0.96); filter: blur(2px); }
            100% { opacity: 1; transform: translate(-50%, 0) scale(1); filter: blur(0); }
        }
        @keyframes toastOut {
            0% { opacity: 1; transform: translate(-50%, 0) scale(1); }
            100% { opacity: 0; transform: translate(-50%, -12px) scale(0.98); }
        }
        .toast-enter { animation: toastIn 240ms cubic-bezier(0.2, 0.9, 0.2, 1) forwards; }
        .toast-exit { animation: toastOut 180ms ease-in forwards; }
        .badge-premium {
            background: linear-gradient(130deg, #fef08a 0%, #f59e0b 45%, #fde68a 100%);
            color: #5b3400;
            box-shadow: 0 8px 28px rgba(245, 158, 11, 0.45);
        }
        .badge-standard {
            background: linear-gradient(130deg, #4338ca 0%, #6366f1 100%);
            color: #e0e7ff;
            box-shadow: 0 8px 22px rgba(67, 56, 202, 0.35);
        }
    </style>
</head>
<body class="min-h-screen overflow-x-hidden bg-slate-50 text-slate-800">
    <div id="patientRecordApp" class="relative flex min-h-screen w-full flex-col overflow-x-hidden px-4 pt-24 pb-6 sm:px-6 sm:pt-32 md:pt-32 lg:px-8 lg:pt-32 xl:px-10">
        <header class="fixed inset-x-0 top-0 z-50 hidden w-full border-b border-white/15 bg-[#1e1b4b]/85 shadow-2xl shadow-indigo-950/35 backdrop-blur-2xl md:block">
            <div class="mx-auto flex w-full max-w-none flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8 xl:px-10">
                <div class="flex items-center gap-3 text-white">
                    <img id="clinicLogoImg" src="logo.png" alt="شعار العيادة" class="h-12 w-12 rounded-xl border border-white/10 bg-white/10 object-contain p-2 shadow-lg shadow-indigo-950/25" />
                    <div class="flex items-center gap-3">
                        <h1 id="clinicTitle" class="text-lg font-extrabold tracking-tight text-white sm:text-xl">عيادة الطبيب</h1>
                        <span id="tierBadge" class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-extrabold tracking-wide text-white shadow-[0_0_18px_rgba(129,140,248,0.18)]">Standard</span>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 lg:flex-1 lg:justify-center">
                    <a href="index.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">👥 لوحة المرضى</a>
                    <a href="appointments.html" class="rounded-2xl border border-cyan-300/30 bg-cyan-500/15 px-4 py-2 text-sm font-extrabold text-cyan-50 shadow-[0_0_24px_rgba(34,211,238,0.14)] transition hover:-translate-y-0.5 hover:border-cyan-200/50 hover:bg-cyan-400/20 hover:shadow-[0_0_28px_rgba(34,211,238,0.26)]">📅 المواعيد اليومية</a>
                    <a href="finance.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">📊 التقارير المالية</a>
                    <a href="inventory.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">📦 مخزن المواد</a>
                    <a href="contact_developer.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">🛠️ تواصل مع المطور</a>
                    <a href="profile.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">👤 حسابي</a>
                    <button id="logoutBtn" type="button" class="rounded-2xl border border-rose-300/30 bg-rose-500/15 px-4 py-2 text-sm font-bold text-rose-100 transition hover:-translate-y-0.5 hover:border-rose-200/50 hover:bg-rose-500/25 hover:shadow-[0_0_24px_rgba(244,63,94,0.18)]">⎋ تسجيل الخروج</button>
                </div>
            </div>
        </header>

        <div class="fixed inset-x-0 top-0 z-[60] border-b border-white/15 bg-[#1e1b4b]/90 shadow-2xl shadow-indigo-950/35 backdrop-blur-2xl md:hidden">
            <div class="relative mx-auto flex w-full max-w-none items-center justify-between gap-3 px-4 py-3 sm:px-6">
                <div class="flex min-w-0 items-center gap-3 text-white">
                    <img id="mobileClinicLogoImg" src="logo.png" alt="شعار العيادة" class="h-10 w-10 rounded-xl border border-white/10 bg-white/10 object-contain p-1.5 shadow-lg shadow-indigo-950/25" />
                    <div class="min-w-0">
                        <div class="flex min-w-0 items-center gap-2">
                            <p id="mobileClinicTitle" class="truncate text-sm font-extrabold tracking-tight text-white">عيادة الطبيب</p>
                            <span id="mobileTierBadge" class="shrink-0 rounded-full border border-white/15 bg-white/10 px-2 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-[0_0_18px_rgba(129,140,248,0.18)]">Standard</span>
                        </div>
                    </div>
                </div>

                <button id="mobileMenuToggle" type="button" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-white/15 bg-white/10 text-white shadow-lg shadow-indigo-950/20 transition hover:bg-white/15" aria-expanded="false" aria-controls="mobileMenuDropdown">
                    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M4 7h16"></path>
                        <path d="M4 12h16"></path>
                        <path d="M4 17h16"></path>
                    </svg>
                </button>

                <div id="mobileMenuDropdown" class="absolute left-0 right-0 top-full hidden border-t border-white/10 bg-[#1e1b4b] px-4 py-3 shadow-2xl shadow-indigo-950/35 md:hidden">
                    <div class="mx-auto flex w-full max-w-none flex-col gap-2 sm:px-2">
                        <a href="index.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">👥 لوحة المرضى</a>
                        <a href="appointments.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">📅 المواعيد اليومية</a>
                        <a href="finance.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">📊 التقارير المالية</a>
                        <a href="inventory.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">📦 مخزن المواد</a>
                        <a href="contact_developer.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">🛠️ تواصل مع المطور</a>
                        <a href="profile.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">👤 حسابي</a>
                        <button id="mobileLogoutBtn" type="button" class="rounded-2xl border border-rose-300/30 bg-rose-500/15 px-4 py-3 text-right text-sm font-bold text-rose-100 transition hover:bg-rose-500/25">⎋ تسجيل الخروج</button>
                    </div>
                </div>
            </div>
        </div>

        <main class="min-w-0 flex-1 overflow-x-hidden p-4 sm:p-6 lg:p-8 xl:p-10">
            <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <h2 class="text-2xl font-extrabold text-slate-800 sm:text-3xl">جدول المواعيد اليومية</h2>
                    <p class="mt-1 text-sm text-slate-500">تابع جميع المواعيد واستقبل مواعيد جديدة بسهولة.</p>
                </div>
                <button id="openModalBtn" class="w-full rounded-xl bg-indigo-600 px-5 py-3 font-bold text-white shadow-lg transition hover:bg-indigo-700 sm:w-auto">
                    + إضافة موعد جديد
                </button>
            </div>

            <section id="bookingRequestsSection" class="mb-6 rounded-3xl border border-amber-200 bg-amber-50/60 p-4 shadow-xl sm:p-6">
                <div class="mb-4 flex items-center justify-between gap-3">
                    <div>
                        <h3 class="text-xl font-bold text-amber-900">🔔 طلبات حجز جديدة</h3>
                        <p class="mt-1 text-sm text-amber-700/80">طلبات وصلت من صفحة الحجز العامة وبانتظار ردّك (قبول أو رفض).</p>
                    </div>
                    <span id="bookingRequestsCountBadge" class="rounded-full bg-amber-100 px-3 py-1 text-sm font-bold text-amber-800">0</span>
                </div>
                <div id="bookingRequestsList" class="space-y-3">
                    <p class="text-sm text-slate-500">لا توجد طلبات حجز جديدة حالياً.</p>
                </div>
            </section>

            <section class="rounded-3xl border border-slate-200 bg-white p-4 shadow-xl sm:p-6">
                <div class="mb-4 flex items-center justify-between">
                    <h3 class="text-xl font-bold text-indigo-900">المواعيد</h3>
                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700">محدث تلقائيًا</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full border-collapse text-right">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-sm text-slate-600">
                                <th class="px-4 py-3 font-semibold">ID</th>
                                <th class="px-4 py-3 font-semibold">اسم المريض</th>
                                <th class="px-4 py-3 font-semibold">الوقت</th>
                                <th class="px-4 py-3 font-semibold">الإجراء</th>
                                <th class="px-4 py-3 font-semibold">حالة الموعد</th>
                                <th class="px-4 py-3 font-semibold">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="appointmentsTableBody" class="divide-y divide-slate-100">
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <div id="toast" class="pointer-events-none fixed left-1/2 top-6 z-[70] hidden w-[min(92vw,28rem)] -translate-x-1/2 rounded-3xl border border-white/20 bg-[linear-gradient(160deg,_rgba(15,23,42,0.96),_rgba(49,46,129,0.95),_rgba(67,56,202,0.94))] px-4 py-3 text-sm font-semibold text-white shadow-2xl shadow-indigo-950/40 backdrop-blur-xl opacity-0">
    </div>

    <div id="confirmModal" class="fixed inset-0 z-[75] hidden items-center justify-center bg-slate-950/80 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-200">
        <div class="w-full max-w-sm scale-95 rounded-3xl border border-violet-300/25 bg-[#2e1065] p-6 text-center text-violet-50 shadow-2xl shadow-indigo-950/70 transition-transform duration-200">
            <div id="confirmModalIcon" class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-violet-300/40 bg-violet-500/15 text-2xl text-violet-100">❓</div>
            <h3 id="confirmModalTitle" class="text-lg font-extrabold text-white">تأكيد العملية</h3>
            <p id="confirmModalMessage" class="mt-2 text-sm leading-relaxed text-violet-200/90"></p>
            <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-center">
                <button id="confirmModalCancelBtn" type="button" class="w-full rounded-2xl border border-slate-300/45 bg-slate-200/20 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:bg-slate-200/30 sm:w-auto">إلغاء</button>
                <button id="confirmModalConfirmBtn" type="button" class="w-full rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:from-indigo-700 hover:to-violet-700 sm:w-auto">تأكيد</button>
            </div>
        </div>
    </div>

    <div id="appointmentModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-200">
        <div class="w-full max-w-2xl scale-95 rounded-3xl border border-violet-300/25 bg-[#2e1065] p-5 text-violet-50 shadow-2xl shadow-indigo-950/70 transition-transform duration-200 sm:p-6">
            <div class="mb-5 flex items-start justify-between gap-4">
                <div>
                    <p class="text-sm font-semibold text-violet-200">إضافة موعد جديد</p>
                    <h3 class="mt-1 text-2xl font-extrabold text-white">موعد طبي جديد</h3>
                </div>
                <button id="closeModalBtn" type="button" class="rounded-full border border-slate-300/45 bg-slate-200/20 px-3 py-2 text-sm font-semibold text-slate-100 transition hover:bg-slate-200/30">إغلاق</button>
            </div>

            <form id="appointmentForm" class="space-y-4">
                <div>
                    <label class="mb-1 block text-xs font-semibold text-violet-100">اختر المريض</label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-violet-200/80">🔎</span>
                        <input
                            id="appointmentPatientSearch"
                            list="appointmentPatientOptions"
                            type="text"
                            required
                            placeholder="ابحث باسم المريض ثم اختره من القائمة"
                            class="w-full rounded-2xl border border-violet-200/30 bg-white/10 py-3 pr-10 pl-4 text-sm text-white outline-none transition placeholder:text-violet-200/60 focus:border-violet-300 focus:ring-4 focus:ring-violet-300/25"
                        />
                        <datalist id="appointmentPatientOptions"></datalist>
                        <input id="appointmentPatientId" type="hidden" required />
                    </div>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <label class="block">
                        <span class="mb-1 block text-xs font-semibold text-violet-100">التاريخ</span>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-violet-200/80">📅</span>
                            <input id="appointmentDate" type="date" required class="w-full rounded-2xl border border-violet-200/30 bg-white/10 py-3 pr-10 pl-4 text-sm text-white outline-none transition focus:border-violet-300 focus:ring-4 focus:ring-violet-300/25" />
                        </div>
                    </label>
                    <label class="block">
                        <span class="mb-1 block text-xs font-semibold text-violet-100">الوقت</span>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-violet-200/80">🕒</span>
                            <input id="appointmentTime" type="time" required class="w-full rounded-2xl border border-violet-200/30 bg-white/10 py-3 pr-10 pl-4 text-sm text-white outline-none transition focus:border-violet-300 focus:ring-4 focus:ring-violet-300/25" />
                        </div>
                    </label>
                </div>

                <label class="block">
                    <span class="mb-1 block text-xs font-semibold text-violet-100">الوصف / الملاحظات</span>
                    <textarea id="appointmentDescription" rows="4" required placeholder="اكتب وصف الموعد أو الإجراء الطبي..." class="w-full rounded-2xl border border-indigo-300/35 bg-white/10 px-4 py-3 text-sm text-white outline-none transition placeholder:text-violet-200/60 focus:border-violet-300 focus:ring-4 focus:ring-violet-300/25"></textarea>
                </label>

                <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
                    <button id="cancelModalBtn" type="button" class="rounded-2xl border border-slate-300/45 bg-slate-200/20 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:bg-slate-200/30">إلغاء</button>
                    <button id="appointmentSubmitBtn" type="submit" class="rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:from-indigo-700 hover:to-violet-700">
                        حفظ الموعد
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="api-config.js"></script>
    <script src="clinic-loader.js"></script>
    <script>
        const doctorName = localStorage.getItem('doctor_name') || localStorage.getItem('user_name');
        const userTier = localStorage.getItem('user_tier');
        // 🔒 حظر فوري ومتزامن لأي زائر لم يسجّل الدخول إطلاقاً -- بدون هذا الفحص كان أي زائر مجهول (وصل مثلاً عبر قائمة تنقل صفحة عامة مثل contact_developer.html) يتجاوز الحماية لأن userTier الفارغ (null) لا يساوي 'pending_activation'، والأخطر أن دوال جلب البيانات في هذا الملف تسقط على بريد الطبيب الاحتياطي الحقيقي عند غياب تسجيل الدخول فتعرض بياناته الفعلية لأي زائر.
        if (!localStorage.getItem('user_email')) {
            window.location.replace('login.html');
        }
        // 🔒 حظر فوري ومتزامن قبل أي تسجيل لمستمع DOMContentLoaded أو أي طلب Fetch لبيانات محمية -- التوجيه وحده في نهاية الملف لم يكن كافياً لأن السكربت الحالي يستمر بالتنفيذ حتى بعد استدعاء window.location، فكان بإمكان استدعاءات جلب البيانات أن تُنفَّذ وتُعرض قبل اكتمال التنقل الفعلي.
        if (userTier === 'pending_activation') {
            window.location.replace('index.html');
        }

        // 🔒 قفل التجديد الشهري اللطيف (Soft Paywall) لحساب expired_subscription:
        // غير هدّام عمداً -- ينقل عناصر body الحالية داخل غلاف مموَّه (blur) بدل
        // حذفها، ويضيف نافذة التجديد كعنصر شقيق (وليس ابناً للغلاف) حتى لا يكسر
        // CSS filter تموضعها الثابت (position: fixed) ولا يموّهها هي أيضاً بالخطأ.
        function renderExpiredSubscriptionLock() {
                if (document.getElementById('expiredSubscriptionOverlay')) return;

                const blurWrap = document.createElement('div');
                blurWrap.id = 'expiredBlurWrap';
                blurWrap.style.filter = 'blur(8px)';
                blurWrap.style.pointerEvents = 'none';
                blurWrap.style.userSelect = 'none';
                while (document.body.firstChild) {
                        blurWrap.appendChild(document.body.firstChild);
                }
                document.body.appendChild(blurWrap);

                const overlay = document.createElement('div');
                overlay.id = 'expiredSubscriptionOverlay';
                overlay.setAttribute('dir', 'rtl');
                overlay.className = 'fixed inset-0 z-[999] flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 font-sans';
                overlay.innerHTML = `
                        <div class="max-w-xl w-full bg-indigo-950/60 backdrop-blur-2xl border border-purple-500/25 p-8 rounded-3xl shadow-2xl shadow-purple-950/60 text-center space-y-6">
                                <div class="w-20 h-20 bg-purple-500/10 border border-purple-500/30 rounded-2xl flex items-center justify-center mx-auto text-4xl shadow-lg shadow-purple-500/10 animate-pulse">
                                🔒
                                </div>

                                <h1 class="text-2xl font-bold text-purple-300">انتهت صلاحية باقتك</h1>

                                <p class="text-slate-300 leading-relaxed text-sm">
                                    مرحباً يا دكتور، نود إعلامك بأن فترة صلاحية باقتك الحالية قد انتهت. سجلات مرضاك، مواعيدك، ومخزن عيادتك في أمان تام ومحفوظة أبدياً داخل السيرفر ولا تضيع أبداً 🔒. للمتابعة الفورية واستعادة صلاحيات الإدارة كاملة، يرجى إدخال كود التجديد الشهري الجديد. للدعم الفني السريع والحصول على الكود كاش، يرجى التواصل مع مطور المنصة المهندس فارس حلاوي على الرقم: 0956907698 🛠️
                                </p>

                                <div class="space-y-3">
                                    <input type="text" id="renewalKeyInput" placeholder="أدخل كود التجديد الجديد هنا"
                                           class="w-full bg-slate-900 border border-purple-500/25 rounded-xl px-4 py-3 text-center text-sm focus:outline-none focus:border-purple-400 transition-colors text-white placeholder-slate-500" />

                                    <p id="renewalStatusMsg" class="text-xs min-h-[1rem]"></p>

                                    <button id="renewSubscriptionBtn" onclick="renewSubscription()"
                                            class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold py-3 rounded-xl transition-all shadow-lg shadow-purple-600/30 active:scale-[0.98]">
                                        تجديد الاشتراك ومتابعة العمل 🚀
                                    </button>
                                </div>
                        </div>
                `;
                document.body.appendChild(overlay);
        }

        // دالة التحقق من كود التجديد الشهري -- تستدعي نفس مسار /api/activate الموحّد
        // (مسار مزدوج الغرض: يفعّل حساباً جديداً أو يجدّد حساباً منتهياً بنفس المنطق)
        function renewSubscription() {
                const input = document.getElementById('renewalKeyInput');
                const statusEl = document.getElementById('renewalStatusMsg');
                const btn = document.getElementById('renewSubscriptionBtn');
                const keyCode = (input && input.value || '').trim();

                if (!keyCode) {
                        if (statusEl) {
                                statusEl.textContent = 'يرجى إدخال كود التجديد أولاً.';
                                statusEl.className = 'text-xs min-h-[1rem] text-rose-400';
                        }
                        return;
                }

                if (btn) {
                        btn.disabled = true;
                        btn.textContent = 'جاري التحقق من الكود...';
                }
                if (statusEl) {
                        statusEl.textContent = 'يتم الاتصال بالخادم الآن...';
                        statusEl.className = 'text-xs min-h-[1rem] text-indigo-300';
                }

                fetch('/api/activate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                                email: localStorage.getItem('user_email'),
                                activation_key: keyCode,
                        }),
                })
                        .then(async (res) => {
                                let data = null;
                                try {
                                    data = await res.json();
                                } catch (parseError) {
                                    data = null;
                                }

                                if (!res.ok) {
                                    const message = (data && data.detail) || 'تعذر التحقق من الكود. حاول مرة أخرى.';
                                    if (statusEl) {
                                        statusEl.textContent = message;
                                        statusEl.className = 'text-xs min-h-[1rem] text-rose-400';
                                    }
                                    if (btn) {
                                        btn.disabled = false;
                                        btn.textContent = 'تجديد الاشتراك ومتابعة العمل 🚀';
                                    }
                                    return;
                                }

                                localStorage.setItem('user_tier', data.user_tier);
                                if (statusEl) {
                                    statusEl.textContent = '🎉 تم التجديد بنجاح!';
                                    statusEl.className = 'text-xs min-h-[1rem] text-emerald-400';
                                }
                                // رسالة تهنئة منبثقة فورية حسب الطلب، ثم إعادة تحميل الصفحة
                                // لإظهار كامل عناصر لوحة التحكم بعد استعادة الصلاحيات.
                                showToast('🎉 تم تجديد اشتراكك بنجاح! سيتم تحديث الصفحة الآن لإظهار كامل صلاحيات لوحة التحكم.', 'success');
                                window.setTimeout(() => window.location.reload(), 1800);
                        })
                        .catch(() => {
                                if (statusEl) {
                                    statusEl.textContent = 'تعذر الاتصال بالخادم. تحقق من الإنترنت وحاول مرة أخرى.';
                                    statusEl.className = 'text-xs min-h-[1rem] text-rose-400';
                                }
                                if (btn) {
                                    btn.disabled = false;
                                    btn.textContent = 'تجديد الاشتراك ومتابعة العمل 🚀';
                                }
                        });
        }

        if (userTier === 'expired_subscription') {
            renderExpiredSubscriptionLock();
        }
        const titleElement = document.getElementById('clinicTitle');
        const tierBadge = document.getElementById('tierBadge');
        const mobileClinicTitle = document.getElementById('mobileClinicTitle');
        const mobileTierBadge = document.getElementById('mobileTierBadge');
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const mobileMenuDropdown = document.getElementById('mobileMenuDropdown');
        const mobileLogoutBtn = document.getElementById('mobileLogoutBtn');
        const logoutBtn = document.getElementById('logoutBtn');

        function handleLogout() {
            localStorage.removeItem('doctor_name');
            localStorage.removeItem('user_email');
            localStorage.removeItem('doctor_id');
            localStorage.removeItem('user_tier');
            window.location.href = 'login.html';
        }

        function renderTierBadge() {
            if (!tierBadge) return;
            if (userTier === 'premium') {
                tierBadge.className = 'badge-premium rounded-full px-3 py-1 text-xs font-extrabold tracking-wide';
                tierBadge.textContent = 'Premium 👑';
                if (mobileTierBadge) {
                    mobileTierBadge.className = 'shrink-0 rounded-full border border-emerald-300/30 bg-emerald-400/15 px-2 py-1 text-[11px] font-extrabold tracking-wide text-emerald-50 shadow-[0_0_18px_rgba(52,211,153,0.18)]';
                    mobileTierBadge.textContent = 'Premium 👑';
                }
                return;
            }

            tierBadge.className = 'badge-standard rounded-full px-3 py-1 text-xs font-extrabold tracking-wide';
            tierBadge.textContent = 'Standard';
            if (mobileTierBadge) {
                mobileTierBadge.className = 'shrink-0 rounded-full border border-white/15 bg-white/10 px-2 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-[0_0_18px_rgba(129,140,248,0.18)]';
                mobileTierBadge.textContent = 'Standard';
            }
        }

        if (logoutBtn) {
            logoutBtn.addEventListener('click', handleLogout);
        }

        if (mobileLogoutBtn) {
            mobileLogoutBtn.addEventListener('click', handleLogout);
        }

        if (mobileMenuToggle && mobileMenuDropdown) {
            mobileMenuToggle.addEventListener('click', () => {
                const isHidden = mobileMenuDropdown.classList.contains('hidden');
                mobileMenuDropdown.classList.toggle('hidden');
                mobileMenuToggle.setAttribute('aria-expanded', String(isHidden));
            });
        }

        if (titleElement) {
            titleElement.textContent = doctorName ? `عيادة ${doctorName}` : 'عيادة الطبيب المعتمد';
        }
        if (mobileClinicTitle) {
            mobileClinicTitle.textContent = doctorName ? `عيادة ${doctorName}` : 'عيادة الطبيب المعتمد';
        }
        renderTierBadge();

        const API_URL = apiUrl('/api/appointments');
        const PATIENTS_API_URL = apiUrl('/api/patients');

        // Every /api/* route below (except /api/activate) requires a doctor-identifying
        // header, added server-side in the 2026-08-22 activation/paywall audit.
        function getDoctorEmail() {
            return (localStorage.getItem('user_email') || 'fareshalawi17@gmail.com').trim();
        }

        function getSessionToken() {
            return (localStorage.getItem('authToken') || '').trim();
        }

        function getDoctorAuthHeaders(extraHeaders = {}) {
            const headers = { 'X-Doctor-Email': getDoctorEmail(), ...extraHeaders };
            const token = getSessionToken();
            if (token) {
                headers.Authorization = token.startsWith('Bearer ') ? token : `Bearer ${token}`;
            }
            return headers;
        }
        const tableBody = document.getElementById('appointmentsTableBody');
        const modal = document.getElementById('appointmentModal');
        const form = document.getElementById('appointmentForm');
        const patientSearchInput = document.getElementById('appointmentPatientSearch');
        const patientIdInput = document.getElementById('appointmentPatientId');
        const patientOptionsList = document.getElementById('appointmentPatientOptions');
        const appointmentSubmitBtn = document.getElementById('appointmentSubmitBtn');
        const toast = document.getElementById('toast');
        const currentDoctorName = localStorage.getItem('doctor_name') || 'الطبيب المعالج';
        let appointmentModalCloseTimer = null;
        let allPatients = [];
        let currentAppointments = [];
        let currentBookingRequests = [];
        let activeAppointment = null;
        let toastTimer = null;
        let isAppointmentActionInProgress = false;
        let appointmentsAutoRefreshTimer = null;

        const APPOINTMENT_STATUS_OPTIONS = {
            pending: {
                label: 'في الانتظار',
                rowClass: 'bg-amber-50/80 ring-1 ring-amber-200/70',
                badgeClass: 'bg-amber-100 text-amber-800 border border-amber-200',
            },
            checked_in: {
                label: 'دخل العيادة',
                rowClass: 'bg-emerald-50/80 ring-1 ring-emerald-200/70',
                badgeClass: 'bg-emerald-100 text-emerald-800 border border-emerald-200',
            },
            no_show: {
                label: 'تخلف عن الموعد',
                rowClass: 'bg-rose-50/80 ring-1 ring-rose-200/70',
                badgeClass: 'bg-rose-100 text-rose-800 border border-rose-200',
            },
        };

        function normalizeAppointmentStatus(status) {
            const normalized = String(status || 'pending').trim().toLowerCase();
            return Object.prototype.hasOwnProperty.call(APPOINTMENT_STATUS_OPTIONS, normalized)
                ? normalized
                : 'pending';
        }

        function getAppointmentStatusMeta(status) {
            return APPOINTMENT_STATUS_OPTIONS[normalizeAppointmentStatus(status)] || APPOINTMENT_STATUS_OPTIONS.pending;
        }

        function setAppointmentRowStatus(row, status) {
            if (!row) return;

            const normalizedStatus = normalizeAppointmentStatus(status);
            row.dataset.appointmentStatus = normalizedStatus;
            row.classList.remove(
                'bg-amber-50/80', 'ring-1', 'ring-amber-200/70',
                'bg-emerald-50/80', 'ring-1', 'ring-emerald-200/70',
                'bg-rose-50/80', 'ring-1', 'ring-rose-200/70'
            );
            row.classList.add(...getAppointmentStatusMeta(normalizedStatus).rowClass.split(' '));
        }

        function showToast(message, tone = 'info') {
            if (!toast) {
                alert(message);
                return;
            }

            if (toastTimer) {
                window.clearTimeout(toastTimer);
                toastTimer = null;
            }

            const toneClasses = {
                success: 'border-emerald-300/30 bg-[linear-gradient(160deg,_rgba(6,78,59,0.96),_rgba(16,185,129,0.9),_rgba(5,150,105,0.95))] shadow-emerald-950/30',
                error: 'border-rose-300/30 bg-[linear-gradient(160deg,_rgba(127,29,29,0.96),_rgba(225,29,72,0.9),_rgba(190,18,60,0.95))] shadow-rose-950/30',
                info: 'border-white/20 bg-[linear-gradient(160deg,_rgba(15,23,42,0.96),_rgba(49,46,129,0.95),_rgba(67,56,202,0.94))] shadow-indigo-950/40',
            };

            toast.className = `pointer-events-none fixed left-1/2 top-6 z-[70] hidden w-[min(92vw,28rem)] -translate-x-1/2 rounded-3xl border px-4 py-3 text-sm font-semibold text-white shadow-2xl backdrop-blur-xl opacity-0 ${toneClasses[tone] || toneClasses.info}`;
            toast.textContent = message;
            toast.classList.remove('hidden', 'toast-exit');
            toast.classList.add('toast-enter');

            toastTimer = window.setTimeout(() => {
                toast.classList.remove('toast-enter');
                toast.classList.add('toast-exit');
                window.setTimeout(() => {
                    toast.classList.add('hidden');
                    toast.classList.remove('toast-exit');
                }, 180);
            }, 2400);
        }

        const confirmModal = document.getElementById('confirmModal');
        const confirmModalIcon = document.getElementById('confirmModalIcon');
        const confirmModalTitle = document.getElementById('confirmModalTitle');
        const confirmModalMessage = document.getElementById('confirmModalMessage');
        const confirmModalCancelBtn = document.getElementById('confirmModalCancelBtn');
        const confirmModalConfirmBtn = document.getElementById('confirmModalConfirmBtn');
        let confirmModalCloseTimer = null;
        let confirmModalResolver = null;

        const CONFIRM_TONE_STYLES = {
            danger: {
                icon: '🗑️',
                iconClass: 'border-rose-300/40 bg-rose-500/15 text-rose-100',
                confirmClass: 'bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700',
            },
            success: {
                icon: '✅',
                iconClass: 'border-emerald-300/40 bg-emerald-500/15 text-emerald-100',
                confirmClass: 'bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700',
            },
            default: {
                icon: '❓',
                iconClass: 'border-violet-300/40 bg-violet-500/15 text-violet-100',
                confirmClass: 'bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700',
            },
        };

        function closeConfirmModal(result) {
            if (!confirmModal) return;

            confirmModal.classList.add('opacity-0');
            const panel = confirmModal.firstElementChild;
            if (panel) {
                panel.classList.add('scale-95');
            }

            if (confirmModalCloseTimer) {
                window.clearTimeout(confirmModalCloseTimer);
            }
            confirmModalCloseTimer = window.setTimeout(() => {
                confirmModal.classList.add('hidden');
                confirmModal.classList.remove('flex');
                confirmModalCloseTimer = null;
            }, 180);

            if (confirmModalResolver) {
                const resolve = confirmModalResolver;
                confirmModalResolver = null;
                resolve(result);
            }
        }

        function showConfirm(message, options = {}) {
            const tone = CONFIRM_TONE_STYLES[options.tone] || CONFIRM_TONE_STYLES.default;

            return new Promise((resolve) => {
                if (!confirmModal) {
                    resolve(window.confirm(message));
                    return;
                }

                if (confirmModalResolver) {
                    closeConfirmModal(false);
                }
                confirmModalResolver = resolve;

                confirmModalTitle.textContent = options.title || 'تأكيد العملية';
                confirmModalMessage.textContent = message;
                confirmModalIcon.textContent = options.icon || tone.icon;
                confirmModalIcon.className = `mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border text-2xl ${tone.iconClass}`;
                confirmModalConfirmBtn.textContent = options.confirmText || 'تأكيد';
                confirmModalConfirmBtn.className = `w-full rounded-full px-6 py-3 text-sm font-bold text-white shadow-lg transition sm:w-auto ${tone.confirmClass}`;
                confirmModalCancelBtn.textContent = options.cancelText || 'إلغاء';

                if (confirmModalCloseTimer) {
                    window.clearTimeout(confirmModalCloseTimer);
                    confirmModalCloseTimer = null;
                }

                confirmModal.classList.remove('hidden');
                confirmModal.classList.add('flex');
                requestAnimationFrame(() => {
                    confirmModal.classList.remove('opacity-0');
                    const panel = confirmModal.firstElementChild;
                    if (panel) {
                        panel.classList.remove('scale-95');
                    }
                });
            });
        }

        confirmModalCancelBtn?.addEventListener('click', () => closeConfirmModal(false));
        confirmModalConfirmBtn?.addEventListener('click', () => closeConfirmModal(true));
        confirmModal?.addEventListener('click', (event) => {
            if (event.target === confirmModal) {
                closeConfirmModal(false);
            }
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && confirmModal && !confirmModal.classList.contains('hidden')) {
                closeConfirmModal(false);
            }
        });

        function normalizeText(value) {
            return String(value || '').trim().toLowerCase();
        }

        function getAppointmentRowClass(status) {
            return getAppointmentStatusMeta(status).rowClass;
        }

        function renderAppointmentStatusSelect(status, appointmentId) {
            const normalizedStatus = normalizeAppointmentStatus(status);
            const statusLabel = getAppointmentStatusMeta(normalizedStatus).label;

            return `
                <label class="flex flex-col gap-2">
                    <span class="text-xs font-semibold text-slate-500 sm:hidden">حالة الموعد</span>
                    <select
                        data-status-select="1"
                        data-appointment-id="${appointmentId ?? ''}"
                        class="w-full min-w-[10rem] rounded-2xl border border-slate-200 bg-white/90 px-3 py-2 text-xs font-bold text-slate-700 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
                    >
                        <option value="pending" ${normalizedStatus === 'pending' ? 'selected' : ''}>في الانتظار</option>
                        <option value="checked_in" ${normalizedStatus === 'checked_in' ? 'selected' : ''}>دخل العيادة</option>
                        <option value="no_show" ${normalizedStatus === 'no_show' ? 'selected' : ''}>تخلف عن الموعد</option>
                    </select>
                    <span class="sm:hidden text-[11px] font-semibold text-slate-400">${statusLabel}</span>
                </label>
            `;
        }

        function renderPatientOptions() {
            if (!patientOptionsList) return;
            patientOptionsList.innerHTML = allPatients.map((patient) => {
                const patientName = String(patient?.full_name || '').trim();
                const patientId = String(patient?.id || '').trim();
                const optionValue = `${patientName} — #${patientId}`;
                return `<option value="${optionValue}"></option>`;
            }).join('');
        }

        function resolveSelectedPatient() {
            const searchValue = String(patientSearchInput?.value || '').trim();
            const idValue = String(patientIdInput?.value || '').trim();

            if (idValue) {
                const byId = allPatients.find((patient) => String(patient?.id) === idValue);
                if (byId) {
                    return byId;
                }
            }

            const byLabel = allPatients.find((patient) => {
                const patientName = String(patient?.full_name || '').trim();
                const patientId = String(patient?.id || '').trim();
                return `${patientName} — #${patientId}` === searchValue;
            });
            if (byLabel) {
                if (patientIdInput) patientIdInput.value = String(byLabel.id);
                return byLabel;
            }

            const byName = allPatients.find((patient) => normalizeText(patient?.full_name) === normalizeText(searchValue));
            if (byName) {
                if (patientIdInput) patientIdInput.value = String(byName.id);
                return byName;
            }

            return null;
        }

        function getPatientByAppointment(appointment) {
            if (!appointment) return null;

            if (appointment.patient_id) {
                const byId = allPatients.find((patient) => String(patient?.id) === String(appointment.patient_id));
                if (byId) return byId;
            }

            const appointmentName = normalizeText(appointment.patient_name);
            if (!appointmentName) return null;
            return allPatients.find((patient) => normalizeText(patient?.full_name) === appointmentName) || null;
        }

        function formatAppointmentDateForReminder(appointment) {
            const rawDate = appointment?.appointment_date;
            if (!rawDate) return 'غير محدد';

            const parsed = new Date(rawDate);
            if (Number.isNaN(parsed.getTime())) return 'غير محدد';
            return parsed.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        function normalizeWhatsappPhone(phone) {
            const raw = String(phone || '').trim();
            if (!raw) return '';

            let digits = raw.replace(/\D/g, '');
            if (!digits) return '';

            if (digits.startsWith('00')) {
                digits = digits.slice(2);
            }

            if (digits.startsWith('0')) {
                digits = `963${digits.slice(1)}`;
            } else if (!digits.startsWith('963') && digits.length === 9) {
                digits = `963${digits}`;
            }

            return digits;
        }

        function sendWhatsappReminder(appointment) {
            if (!appointment) return;

            const patientRecord = getPatientByAppointment(appointment);
            const patientPhone = normalizeWhatsappPhone(patientRecord?.phone || appointment?.phone || appointment?.patient_phone);
            if (!patientPhone) {
                showToast('تعذر إرسال التذكير: رقم هاتف المريض غير متوفر أو غير صالح.', 'error');
                return;
            }

            const patientName = String(appointment?.patient_name || patientRecord?.full_name || 'المريض').trim();
            const appointmentDate = formatAppointmentDateForReminder(appointment);
            const appointmentTime = String(appointment?.appointment_time || 'غير محدد').trim() || 'غير محدد';
            const message = `مرحباً سيد/ة ${patientName}، نذكركم بموعدكم القادم في العيادة ${currentDoctorName} اليوم ${appointmentDate} عند الساعة ${appointmentTime}. نتمنى لكم دوام الصحة والعافية. 🦷✨`;

            const whatsappUrl = `https://whatsapp.com/send?phone=${patientPhone}&text=${encodeURIComponent(message)}`;
            window.open(whatsappUrl, '_blank');
        }

        async function loadPatientsForAppointmentForm() {
            try {
                const response = await fetch(PATIENTS_API_URL, { headers: getDoctorAuthHeaders() });
                if (!response.ok) {
                    throw new Error('تعذر تحميل قائمة المرضى');
                }

                const data = await response.json();
                allPatients = Array.isArray(data) ? data : [];
                renderPatientOptions();
            } catch (error) {
                allPatients = [];
                renderPatientOptions();
            }
        }

        function setCreateMode() {
            activeAppointment = null;
            if (appointmentSubmitBtn) {
                appointmentSubmitBtn.textContent = 'حفظ الموعد';
            }
        }

        function setEditMode(appointment) {
            activeAppointment = appointment;
            if (appointmentSubmitBtn) {
                appointmentSubmitBtn.textContent = 'حفظ التعديلات';
            }

            if (patientSearchInput) {
                if (appointment?.patient_id) {
                    const knownPatient = allPatients.find((patient) => String(patient.id) === String(appointment.patient_id));
                    if (knownPatient) {
                        patientSearchInput.value = `${knownPatient.full_name} — #${knownPatient.id}`;
                    } else {
                        const fallbackName = String(appointment?.patient_name || '').trim();
                        patientSearchInput.value = fallbackName ? `${fallbackName} — #${appointment.patient_id}` : '';
                    }
                    if (patientIdInput) {
                        patientIdInput.value = String(appointment.patient_id);
                    }
                } else {
                    patientSearchInput.value = String(appointment?.patient_name || '').trim();
                    if (patientIdInput) {
                        patientIdInput.value = '';
                    }
                }
            }

            const dateInput = document.getElementById('appointmentDate');
            const timeInput = document.getElementById('appointmentTime');
            const descriptionInput = document.getElementById('appointmentDescription');

            if (dateInput) {
                const appointmentDate = appointment?.appointment_date ? new Date(appointment.appointment_date) : null;
                dateInput.value = appointmentDate && !Number.isNaN(appointmentDate.getTime())
                    ? appointmentDate.toISOString().slice(0, 10)
                    : '';
            }

            if (timeInput) {
                const appointmentTime = String(appointment?.appointment_time || '').slice(0, 5);
                if (appointmentTime) {
                    timeInput.value = appointmentTime;
                } else {
                    const appointmentDate = appointment?.appointment_date ? new Date(appointment.appointment_date) : null;
                    timeInput.value = appointmentDate && !Number.isNaN(appointmentDate.getTime())
                        ? appointmentDate.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false })
                        : '';
                }
            }

            if (descriptionInput) {
                descriptionInput.value = String(appointment?.notes || appointment?.description || appointment?.procedure_type || '').trim();
            }
        }

        function openModal(appointment = null) {
            if (allPatients.length === 0) {
                loadPatientsForAppointmentForm();
            }

            if (appointment) {
                setEditMode(appointment);
            } else {
                setCreateMode();
            }

            if (appointmentModalCloseTimer) {
                window.clearTimeout(appointmentModalCloseTimer);
                appointmentModalCloseTimer = null;
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            requestAnimationFrame(() => {
                modal.classList.remove('opacity-0');
                const panel = modal.firstElementChild;
                if (panel) {
                    panel.classList.remove('scale-95');
                }
            });
        }

        function closeModal() {
            setCreateMode();
            modal.classList.add('opacity-0');
            const panel = modal.firstElementChild;
            if (panel) {
                panel.classList.add('scale-95');
            }

            appointmentModalCloseTimer = window.setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                appointmentModalCloseTimer = null;
            }, 180);

            form.reset();
            if (patientIdInput) {
                patientIdInput.value = '';
            }
        }

        function renderAppointments(appointments) {
            currentAppointments = Array.isArray(appointments) ? appointments : [];

            if (!currentAppointments.length) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500">لا توجد مواعيد مسجلة حاليًا.</td>
                    </tr>
                `;
                return;
            }

            tableBody.innerHTML = currentAppointments.map((appointment) => {
                const normalizedStatus = normalizeAppointmentStatus(appointment.status);
                const statusMeta = getAppointmentStatusMeta(normalizedStatus);
                const rowClass = `appointment-row block rounded-2xl border border-slate-200 p-2 shadow-sm transition hover:shadow-md sm:table-row sm:rounded-none sm:border-0 sm:p-0 ${statusMeta.rowClass}`;

                return `
                    <tr data-appointment-id="${appointment.id ?? ''}" data-appointment-status="${normalizedStatus}" class="${rowClass}">
                        <td class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 text-sm text-slate-600 last:border-b-0 sm:table-cell sm:border-b-0">
                            <span class="text-xs font-semibold text-slate-400 sm:hidden">ID</span>
                            <span>${appointment.id ?? '-'}</span>
                        </td>
                        <td class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 text-sm font-semibold text-slate-700 last:border-b-0 sm:table-cell sm:border-b-0">
                            <span class="text-xs font-semibold text-slate-400 sm:hidden">اسم المريض</span>
                            <span>${appointment.patient_name || '—'}</span>
                        </td>
                        <td class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 text-sm text-slate-600 last:border-b-0 sm:table-cell sm:border-b-0">
                            <span class="text-xs font-semibold text-slate-400 sm:hidden">الوقت</span>
                            <span>${appointment.appointment_time || '—'}</span>
                        </td>
                        <td class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 text-sm text-slate-600 last:border-b-0 sm:table-cell sm:border-b-0">
                            <span class="text-xs font-semibold text-slate-400 sm:hidden">الإجراء</span>
                            <span>${appointment.procedure_type || '—'}</span>
                        </td>
                        <td class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 text-sm last:border-b-0 sm:table-cell sm:border-b-0">
                            <span class="text-xs font-semibold text-slate-400 sm:hidden">حالة الموعد</span>
                            ${renderAppointmentStatusSelect(normalizedStatus, appointment.id)}
                        </td>
                        <td class="flex items-center justify-between gap-2 border-b border-slate-100 px-4 py-3 text-sm last:border-b-0 sm:table-cell sm:border-b-0">
                            <span class="text-xs font-semibold text-slate-400 sm:hidden">إجراءات</span>
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button" data-edit-appointment-id="${appointment.id ?? ''}" class="edit-appointment-btn rounded-xl border border-indigo-200 bg-gradient-to-r from-indigo-100 to-violet-100 px-3 py-2 text-xs font-extrabold text-indigo-800 shadow-sm transition hover:from-indigo-200 hover:to-violet-200">✏️ تعديل</button>
                                <button type="button" data-delete-appointment-id="${appointment.id ?? ''}" class="delete-appointment-btn rounded-xl border border-rose-300 bg-gradient-to-r from-rose-500 to-red-600 px-3 py-2 text-xs font-extrabold text-white shadow-md shadow-rose-300/40 transition hover:from-rose-600 hover:to-red-700">🗑️ حذف</button>
                                <button type="button" data-whatsapp-appointment-id="${appointment.id ?? ''}" class="whatsapp-reminder-btn rounded-xl border border-emerald-300 bg-gradient-to-r from-emerald-500 to-green-600 px-3 py-2 text-xs font-extrabold text-white shadow-[0_0_24px_rgba(34,197,94,0.35)] transition hover:from-emerald-600 hover:to-green-700">تذكير واتساب 📱</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            attachAppointmentRowListeners();
            attachAppointmentStatusListeners();
        }

        function attachAppointmentRowListeners() {
            tableBody.querySelectorAll('.edit-appointment-btn').forEach((button) => {
                button.addEventListener('click', () => {
                    const appointmentId = button.getAttribute('data-edit-appointment-id');
                    if (!appointmentId) return;

                    const appointment = currentAppointments.find((item) => String(item.id) === String(appointmentId));
                    if (!appointment) return;

                    openModal(appointment);
                });
            });

            tableBody.querySelectorAll('.delete-appointment-btn').forEach((button) => {
                button.addEventListener('click', async () => {
                    const appointmentId = button.getAttribute('data-delete-appointment-id');
                    if (!appointmentId) return;

                    const confirmed = await showConfirm('هل أنت متأكد من حذف هذا الموعد نهائياً؟', {
                        title: 'حذف الموعد',
                        tone: 'danger',
                        confirmText: 'حذف',
                        cancelText: 'إلغاء',
                    });
                    if (!confirmed) return;

                    const previousText = button.textContent;
                    if (window.ClinicLoader) {
                        ClinicLoader.setButtonLoading(button, true, { loadingText: '...جاري الحذف' });
                    } else {
                        button.disabled = true;
                        button.textContent = '...جاري الحذف';
                    }

                    try {
                        const response = await fetch(`${API_URL}/${encodeURIComponent(String(appointmentId))}`, {
                            method: 'DELETE',
                            headers: getDoctorAuthHeaders(),
                        });

                        if (!response.ok) {
                            throw new Error('تعذر حذف الموعد حالياً.');
                        }

                        await loadAppointments();
                        showToast('تم حذف الموعد بنجاح', 'success');
                    } catch (error) {
                        showToast('تعذر حذف الموعد الآن. يرجى المحاولة لاحقاً.', 'error');
                    } finally {
                        if (window.ClinicLoader) {
                            ClinicLoader.setButtonLoading(button, false);
                        } else {
                            button.disabled = false;
                            button.textContent = previousText || '🗑️ حذف';
                        }
                    }
                });
            });

            tableBody.querySelectorAll('.whatsapp-reminder-btn').forEach((button) => {
                button.addEventListener('click', () => {
                    const appointmentId = button.getAttribute('data-whatsapp-appointment-id');
                    if (!appointmentId) return;

                    const appointment = currentAppointments.find((item) => String(item.id) === String(appointmentId));
                    if (!appointment) {
                        showToast('تعذر العثور على بيانات الموعد لإرسال التذكير.', 'error');
                        return;
                    }

                    sendWhatsappReminder(appointment);
                });
            });
        }

        async function updateAppointmentStatus(appointmentId, status, triggerElement) {
            const response = await fetch(apiUrl(`/api/appointments/${encodeURIComponent(String(appointmentId))}/status`), {
                method: 'PUT',
                headers: getDoctorAuthHeaders({
                    'Content-Type': 'application/json',
                }),
                body: JSON.stringify({ status }),
            });

            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(errorText || 'تعذر تحديث حالة الموعد حالياً');
            }

            const row = triggerElement?.closest('tr');
            if (row) {
                setAppointmentRowStatus(row, status);
            }

            return response.json().catch(() => ({}));
        }

        function attachAppointmentStatusListeners() {
            tableBody.querySelectorAll('[data-status-select="1"]').forEach((select) => {
                select.addEventListener('change', async () => {
                    const appointmentId = select.getAttribute('data-appointment-id');
                    const nextStatus = normalizeAppointmentStatus(select.value);
                    const row = select.closest('tr');
                    const previousStatus = normalizeAppointmentStatus(row?.dataset.appointmentStatus || select.getAttribute('data-previous-status') || 'pending');

                    if (!appointmentId) return;

                    select.disabled = true;
                    select.setAttribute('data-previous-status', previousStatus);
                    isAppointmentActionInProgress = true;

                    try {
                        await updateAppointmentStatus(appointmentId, nextStatus, select);
                        if (row) {
                            row.dataset.appointmentStatus = nextStatus;
                            setAppointmentRowStatus(row, nextStatus);
                        }
                        showToast('تم تحديث حالة الموعد بنجاح', 'success');
                    } catch (error) {
                        select.value = previousStatus;
                        if (row) {
                            setAppointmentRowStatus(row, previousStatus);
                        }
                        showToast('تعذر تحديث حالة الموعد. حاول مرة أخرى.', 'error');
                    } finally {
                        select.disabled = false;
                        isAppointmentActionInProgress = false;
                    }
                });
            });
        }

        async function loadAppointments() {
            try {
                const response = await fetch(API_URL, { headers: getDoctorAuthHeaders() });
                if (!response.ok) {
                    throw new Error('فشل في جلب المواعيد');
                }
                const data = await response.json();
                const allAppointments = Array.isArray(data) ? data : [];

                // طلبات الحجز العام (pending_confirmation) لها لوحتها الخاصة بالأعلى
                // بأزرار قبول/رفض -- ولا تظهر إطلاقاً بجدول المواعيد العادي. طلبات
                // "rejected" اختفت فعلياً من عمل الطبيب اليومي بمجرد الرد عليها،
                // فتُستبعد من الجدول العادي أيضاً بدل تراكمها هناك بلا فائدة.
                const bookingRequests = allAppointments.filter(
                    (appointment) => String(appointment.status || '').trim().toLowerCase() === 'pending_confirmation'
                );
                const normalAppointments = allAppointments.filter((appointment) => {
                    const status = String(appointment.status || '').trim().toLowerCase();
                    return status !== 'pending_confirmation' && status !== 'rejected';
                });

                renderBookingRequests(bookingRequests);
                renderAppointments(normalAppointments);
            } catch (error) {
                console.error(error);
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-sm text-rose-600">تعذر الاتصال بالخادم.</td>
                    </tr>
                `;
            }
        }

        // تحديث تلقائي لجدول المواعيد اليومية كل 30 ثانية، حتى يرى الطبيب
        // مواعيد/طلبات حجز جديدة دون الحاجة لتحديث الصفحة يدوياً. يتوقف
        // مؤقتاً أثناء تعديل الحالة، الرد على طلب حجز، أو فتح نافذة
        // إضافة/تعديل موعد، ويتوقف كلياً عندما تكون الصفحة غير ظاهرة
        // (تبويب آخر مفتوح) لتوفير الطلبات على الخادم.
        const APPOINTMENTS_AUTO_REFRESH_MS = 30000;

        function refreshAppointmentsIfIdle() {
            if (document.visibilityState !== 'visible') return;
            if (isAppointmentActionInProgress) return;
            if (modal && !modal.classList.contains('hidden')) return;
            loadAppointments();
        }

        function startAppointmentsAutoRefresh() {
            if (appointmentsAutoRefreshTimer) {
                clearInterval(appointmentsAutoRefreshTimer);
            }
            appointmentsAutoRefreshTimer = setInterval(refreshAppointmentsIfIdle, APPOINTMENTS_AUTO_REFRESH_MS);
        }

        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
                refreshAppointmentsIfIdle();
            }
        });

        function formatBookingRequestDate(appointment) {
            const rawDate = appointment?.appointment_date;
            if (!rawDate) return '—';
            const parsed = new Date(rawDate);
            if (Number.isNaN(parsed.getTime())) return '—';
            return parsed.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        function renderBookingRequests(requests) {
            currentBookingRequests = Array.isArray(requests) ? requests : [];
            const countBadge = document.getElementById('bookingRequestsCountBadge');
            const list = document.getElementById('bookingRequestsList');
            if (countBadge) countBadge.textContent = String(currentBookingRequests.length);
            if (!list) return;

            if (!currentBookingRequests.length) {
                list.innerHTML = '<p class="text-sm text-slate-500">لا توجد طلبات حجز جديدة حالياً.</p>';
                return;
            }

            list.innerHTML = currentBookingRequests.map((request) => `
                <div class="flex flex-col gap-3 rounded-2xl border border-amber-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between" data-booking-request-id="${request.id ?? ''}">
                    <div class="min-w-0">
                        <p class="font-bold text-slate-800">
                            ${request.patient_name || 'مريض'}
                            ${request.patient_phone ? `<span dir="ltr" class="mr-2 font-mono text-sm text-slate-500">${request.patient_phone}</span>` : ''}
                        </p>
                        <p class="mt-1 text-sm text-slate-600">📅 ${formatBookingRequestDate(request)} — 🕒 ${request.appointment_time || '—'}</p>
                        ${request.notes ? `<p class="mt-1 text-xs text-slate-500">📝 ${request.notes}</p>` : ''}
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <button type="button" data-accept-request-id="${request.id ?? ''}" class="accept-request-btn rounded-xl border border-emerald-300 bg-gradient-to-r from-emerald-500 to-green-600 px-4 py-2 text-xs font-extrabold text-white shadow-md shadow-emerald-300/40 transition hover:from-emerald-600 hover:to-green-700">✅ قبول</button>
                        <button type="button" data-reject-request-id="${request.id ?? ''}" class="reject-request-btn rounded-xl border border-rose-300 bg-gradient-to-r from-rose-500 to-red-600 px-4 py-2 text-xs font-extrabold text-white shadow-md shadow-rose-300/40 transition hover:from-rose-600 hover:to-red-700">❌ رفض</button>
                    </div>
                </div>
            `).join('');

            attachBookingRequestListeners();
        }

        function attachBookingRequestListeners() {
            document.querySelectorAll('.accept-request-btn').forEach((button) => {
                button.addEventListener('click', () => {
                    respondToBookingRequest(button.getAttribute('data-accept-request-id'), 'accept', button);
                });
            });
            document.querySelectorAll('.reject-request-btn').forEach((button) => {
                button.addEventListener('click', () => {
                    respondToBookingRequest(button.getAttribute('data-reject-request-id'), 'reject', button);
                });
            });
        }

        async function respondToBookingRequest(requestId, decision, triggerButton) {
            if (!requestId) return;

            isAppointmentActionInProgress = true;
            try {
                const confirmMessage = decision === 'accept' ? 'تأكيد قبول طلب الحجز هذا؟' : 'تأكيد رفض طلب الحجز هذا؟';
                const confirmed = await showConfirm(confirmMessage, {
                    title: decision === 'accept' ? 'قبول طلب الحجز' : 'رفض طلب الحجز',
                    tone: decision === 'accept' ? 'success' : 'danger',
                    confirmText: decision === 'accept' ? 'قبول' : 'رفض',
                    cancelText: 'إلغاء',
                });
                if (!confirmed) return;

                const wrapper = triggerButton?.closest('[data-booking-request-id]');
                if (wrapper) {
                    wrapper.querySelectorAll('button').forEach((btn) => {
                        if (btn === triggerButton && window.ClinicLoader) {
                            ClinicLoader.setButtonLoading(btn, true, {
                                loadingText: decision === 'accept' ? '...جاري القبول' : '...جاري الرفض',
                            });
                        } else {
                            btn.disabled = true;
                        }
                    });
                }

                try {
                    const response = await fetch(apiUrl(`/api/appointments/${encodeURIComponent(String(requestId))}/respond`), {
                        method: 'PUT',
                        headers: getDoctorAuthHeaders({ 'Content-Type': 'application/json' }),
                        body: JSON.stringify({ decision }),
                    });
                    const data = await response.json().catch(() => ({}));

                    if (!response.ok) {
                        throw new Error(data.detail || 'تعذر إرسال الرد على الطلب.');
                    }

                    showToast(decision === 'accept' ? 'تم قبول طلب الحجز بنجاح ✅' : 'تم رفض طلب الحجز.', decision === 'accept' ? 'success' : 'info');
                    await loadAppointments();
                } catch (error) {
                    showToast(error.message || 'تعذر إرسال الرد على الطلب.', 'error');
                    if (wrapper) {
                        wrapper.querySelectorAll('button').forEach((btn) => {
                            if (btn === triggerButton && window.ClinicLoader) {
                                ClinicLoader.setButtonLoading(btn, false);
                            } else {
                                btn.disabled = false;
                            }
                        });
                    }
                }
            } finally {
                isAppointmentActionInProgress = false;
            }
        }

        // ⚠️ إصلاح جوهري (2026-08-25): كان هذا السطر يمرّر openModal مباشرةً كمستمع
        // نقر، وaddEventListener يستدعي أي مستمع بحدث النقر (Event) كوسيط أول --
        // فكان openModal(event) يتلقّى كائن الحدث بدل null، وبما أنه قيمة صادقة
        // (truthy) كان يدخل في وضع "تعديل موعد" (setEditMode) بدل "إضافة موعد جديد"
        // (setCreateMode) عند كل ضغطة على هذا الزر! هذا لم يكن مجرد خطأ في نص الزر
        // ("حفظ التعديلات" بدل "حفظ الموعد") بل عطّل إضافة أي موعد جديد فعلياً: عند
        // الحفظ كان isEditMode = true فيرسل الكود طلب PUT إلى
        // /api/appointments/undefined (لأن كائن الحدث لا يملك id) بدل POST الصحيح
        // لإنشاء موعد جديد. التفاف السطر بدالة سهمية يمنع تسريب كائن الحدث كوسيط.
        document.getElementById('openModalBtn').addEventListener('click', () => openModal());
        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('cancelModalBtn').addEventListener('click', closeModal);
        modal.addEventListener('click', (event) => {
            if (event.target === modal) {
                closeModal();
            }
        });

        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const selectedPatient = resolveSelectedPatient();
            if (!selectedPatient) {
                showToast('يرجى اختيار مريض موجود من القائمة قبل حفظ الموعد.', 'error');
                return;
            }

            const selectedDate = document.getElementById('appointmentDate').value;
            const selectedTime = document.getElementById('appointmentTime').value;
            const description = document.getElementById('appointmentDescription').value.trim();

            if (!selectedDate || !selectedTime || !description) {
                showToast('يرجى تعبئة جميع حقول الموعد قبل الحفظ.', 'error');
                return;
            }

            const appointmentDateTime = new Date(`${selectedDate}T${selectedTime}:00`);
            if (Number.isNaN(appointmentDateTime.getTime())) {
                showToast('صيغة التاريخ أو الوقت غير صحيحة.', 'error');
                return;
            }

            const payload = {
                patient_id: Number(selectedPatient.id),
                patient_name: String(selectedPatient.full_name || ''),
                date: selectedDate,
                time: selectedTime,
                description,
                appointment_date: appointmentDateTime.toISOString(),
                appointment_time: selectedTime,
                notes: description,
                procedure_type: description,
                status: normalizeAppointmentStatus(activeAppointment?.status || 'pending')
            };

            const submitBtn = document.getElementById('appointmentSubmitBtn');
            const isEditMode = Boolean(activeAppointment);
            if (submitBtn && window.ClinicLoader) {
                ClinicLoader.setButtonLoading(submitBtn, true, {
                    loadingText: isEditMode ? '...جاري تحديث الموعد' : '...جاري حفظ الموعد',
                });
            }

            try {
                const method = isEditMode ? 'PUT' : 'POST';
                const endpoint = isEditMode
                    ? `${API_URL}/${encodeURIComponent(String(activeAppointment.id))}`
                    : API_URL;

                const response = await fetch(endpoint, {
                    method,
                    headers: getDoctorAuthHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || 'فشل حفظ الموعد');
                }

                closeModal();
                await loadAppointments();
                showToast(isEditMode ? 'تم تحديث الموعد بنجاح' : 'تم حفظ الموعد بنجاح', 'success');
            } catch (error) {
                console.error(error);
                showToast(`فشل حفظ الموعد: ${error.message}`, 'error');
            } finally {
                if (submitBtn && window.ClinicLoader) {
                    ClinicLoader.setButtonLoading(submitBtn, false);
                }
            }
        });

        if (patientSearchInput) {
            patientSearchInput.addEventListener('input', () => {
                if (patientIdInput) {
                    patientIdInput.value = '';
                }

                const selectedPatient = resolveSelectedPatient();
                if (selectedPatient && patientIdInput) {
                    patientIdInput.value = String(selectedPatient.id);
                }
            });

            patientSearchInput.addEventListener('blur', () => {
                const selectedPatient = resolveSelectedPatient();
                if (selectedPatient && patientSearchInput) {
                    patientSearchInput.value = `${selectedPatient.full_name} — #${selectedPatient.id}`;
                }
            });
        }

        window.addEventListener('DOMContentLoaded', async () => {
            // خط دفاع ثانٍ: حتى لو لم يكتمل التوجيه أعلاه بعد، لا تُنفَّذ أي
            // عملية جلب بيانات محمية لحساب بانتظار التفعيل.
            const activeGateTier = localStorage.getItem('user_tier');
            if (activeGateTier === 'pending_activation' || activeGateTier === 'expired_subscription') {
                return;
            }
            await Promise.all([loadAppointments(), loadPatientsForAppointmentForm()]);
            startAppointmentsAutoRefresh();
        });
        // ملاحظة: تمت إزالة الفحص المكرر الذي كان هنا -- أصبح الحظر يحدث
        // الآن فوراً في أعلى هذا السكربت (انظر تعريف userTier بالأعلى)، قبل
        // أي محاولة جلب بيانات، بدلاً من الاعتماد على توجيه متأخر هنا.

    
  function applyDoctorAvatarToHeaderLogo() {
    const avatarUrl = localStorage.getItem('user_avatar_url');
    const logoTargets = [document.getElementById('clinicLogoImg'), document.getElementById('mobileClinicLogoImg')].filter(Boolean);
    if (!avatarUrl) return;
    logoTargets.forEach((img) => {
      // نحفظ الشعار الافتراضي logo.png وأصنافه قبل استبداله بصورة الطبيب، حتى نرجع
      // إليه تلقائياً إن فشل تحميل الصورة (رابط معطوب أو محذوف من التخزين المؤقت
      // على Render) بدل ترك أيقونة صورة مكسورة ظاهرة للزائر (2026-08-25).
      const fallbackSrc = img.getAttribute('src');
      const fallbackClassName = img.className;
      img.onerror = () => {
        img.onerror = null;
        img.src = fallbackSrc;
        img.className = fallbackClassName;
      };
      img.src = window.apiUrl ? apiUrl(avatarUrl) : avatarUrl;
      img.classList.remove('object-contain', 'p-2', 'p-1.5', 'rounded-xl');
      img.classList.add('object-cover', 'rounded-full');
    });
  }

  applyDoctorAvatarToHeaderLogo();
</script>
</body>
</html>
