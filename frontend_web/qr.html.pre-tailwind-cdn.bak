<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>QR الدعم - عيادتي الرقمية</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Tajawal', sans-serif; }
    @keyframes floatCard {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    .float-card { animation: floatCard 5.5s ease-in-out infinite; }
    .badge-premium {
      background: linear-gradient(130deg, #fef08a 0%, #f59e0b 45%, #fde68a 100%);
      color: #5b3400;
      box-shadow: 0 8px 28px rgba(245, 158, 11, 0.45);
    }
    .badge-standard {
      background: linear-gradient(130deg, #4338ca 0%, #6366f1 100%);
      color: #e0e7ff;
      box-shadow: 0 8px 22px rgba(67, 56, 202, 0.35);
    }
  </style>
</head>
<body class="min-h-screen overflow-x-hidden bg-[radial-gradient(circle_at_top_left,_rgba(99,102,241,0.22),_transparent_30%),linear-gradient(135deg,_#090719_0%,_#0f172a_45%,_#1e1b4b_100%)] text-slate-100">
  <div class="relative w-full min-h-screen flex flex-col px-4 pt-28 pb-6 sm:px-6 sm:pt-32 lg:px-8 lg:pt-32 xl:px-10">
    <header class="fixed inset-x-0 top-0 z-50 w-full border-b border-white/15 bg-[#1e1b4b]/85 shadow-2xl shadow-indigo-950/35 backdrop-blur-2xl">
      <div class="mx-auto flex w-full max-w-none flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8 xl:px-10">
        <div class="flex items-center gap-3 text-white">
          <img src="logo.png" alt="شعار العيادة" class="h-12 w-12 rounded-xl border border-white/10 bg-white/10 object-contain p-2 shadow-lg shadow-indigo-950/25" />
          <div class="flex items-center gap-3">
            <p id="clinicTitle" class="text-lg font-extrabold tracking-tight text-white sm:text-xl">عيادتي الرقمية</p>
            <span id="tierBadge" class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-extrabold tracking-wide text-white shadow-[0_0_18px_rgba(129,140,248,0.18)]">Standard</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2 lg:flex-1 lg:justify-center">
          <a href="index.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">👥 لوحة المرضى</a>
          <a href="appointments.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">📅 المواعيد اليومية</a>
          <a href="finance.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">📊 التقارير المالية</a>
          <a href="inventory.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">📦 مخزن المواد</a>
          <a href="contact_developer.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">🛠️ تواصل مع المطور</a>
          <a href="qr.html" class="rounded-2xl border border-cyan-300/30 bg-cyan-500/15 px-4 py-2 text-sm font-extrabold text-cyan-50 shadow-[0_0_24px_rgba(34,211,238,0.14)] transition hover:-translate-y-0.5 hover:border-cyan-200/50 hover:bg-cyan-400/20 hover:shadow-[0_0_28px_rgba(34,211,238,0.26)]">🔳 QR الدعم</a>
          <button id="logoutBtn" type="button" class="rounded-2xl border border-rose-300/30 bg-rose-500/15 px-4 py-2 text-sm font-bold text-rose-100 transition hover:-translate-y-0.5 hover:border-rose-200/50 hover:bg-rose-500/25 hover:shadow-[0_0_24px_rgba(244,63,94,0.18)]">⎋ تسجيل الخروج</button>
        </div>
      </div>
    </header>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 xl:p-10">
      <section class="mx-auto max-w-5xl rounded-[30px] border border-white/15 bg-white/5 p-5 shadow-2xl shadow-indigo-950/40 backdrop-blur-xl sm:p-8">
        <div class="mb-8 text-center">
          <p class="inline-flex rounded-full border border-cyan-300/30 bg-cyan-500/15 px-3 py-1 text-xs font-extrabold tracking-[0.2em] text-cyan-100">SUPPORT QR</p>
          <h1 class="mt-4 text-2xl font-black text-white sm:text-3xl">امسح الكود للتواصل الفوري</h1>
          <p class="mt-2 text-sm text-indigo-100/90">تمت إضافة QR تيليغرام وواتساب لسهولة الوصول المباشر.</p>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          <article class="float-card rounded-3xl border border-sky-300/25 bg-[linear-gradient(160deg,_rgba(2,132,199,0.2),_rgba(30,64,175,0.22))] p-5 text-center shadow-[0_20px_40px_rgba(2,132,199,0.2)]">
            <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-sky-200/40 bg-sky-300/15 text-2xl">✈️</div>
            <h2 class="text-lg font-extrabold text-sky-100">QR تيليغرام</h2>
            <p class="mt-1 text-xs text-sky-100/75">اضغط أو امسح الكود للتواصل عبر تيليغرام</p>
            <a id="telegramLink" href="https://t.me/fareshalawi17" target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-2xl border border-sky-200/50 bg-white px-3 py-3 shadow-lg">
              <img id="telegramQr" alt="Telegram QR" class="h-44 w-44 rounded-xl object-cover" />
            </a>
          </article>

          <article class="float-card rounded-3xl border border-emerald-300/25 bg-[linear-gradient(160deg,_rgba(22,163,74,0.2),_rgba(5,150,105,0.24))] p-5 text-center shadow-[0_20px_40px_rgba(22,163,74,0.2)]">
            <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-200/40 bg-emerald-300/15 text-2xl">🟢</div>
            <h2 class="text-lg font-extrabold text-emerald-100">QR واتساب</h2>
            <p class="mt-1 text-xs text-emerald-100/75">اضغط أو امسح الكود لمراسلة الدعم على واتساب</p>
            <a id="whatsappLink" href="https://wa.me/963956907698?text=%D8%A8%D8%B4%D9%85%D9%87%D9%86%D8%AF%D8%B3%20%D9%81%D8%A7%D8%B1%D8%B3%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D8%A5%D9%84%D9%89%20%D8%A7%D9%84%D8%AF%D8%B9%D9%85%20%D8%A7%D9%84%D9%81%D9%86%D9%8A" target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-2xl border border-emerald-200/50 bg-white px-3 py-3 shadow-lg">
              <img id="whatsappQr" alt="WhatsApp QR" class="h-44 w-44 rounded-xl object-cover" />
            </a>
          </article>
        </div>

        <footer class="mt-8 border-t border-white/10 pt-4 text-center">
          <p class="text-xs font-mono tracking-wide text-indigo-200/90">تطوير وإدارة: المهندس فارس حلاوي © 2026</p>
        </footer>
      </section>
    </main>
  </div>

  <script>
    const doctorName = localStorage.getItem('doctor_name');
    const userTier = localStorage.getItem('user_tier');
    // 🔒 حظر فوري ومتزامن لأي زائر لم يسجّل الدخول إطلاقاً -- نفس الحارس المستخدم
    // في index.html/appointments.html/finance.html/inventory.html/patient_record.html/profile.html،
    // كانت هذه الصفحة (ومعها chart.html سابقاً) الوحيدتين المتبقيتين بلا هذا الحارس (2026-08-25).
    if (!localStorage.getItem('user_email')) {
        window.location.replace('login.html');
    }
    const titleElement = document.getElementById('clinicTitle');
    const tierBadge = document.getElementById('tierBadge');
    const logoutBtn = document.getElementById('logoutBtn');

    const telegramUrl = 'https://t.me/fareshalawi17';
    const whatsappUrl = 'https://wa.me/963956907698?text=بشمهندس فارس، أحتاج إلى الدعم الفني';

    function buildQrSrc(url) {
      return `https://api.qrserver.com/v1/create-qr-code/?size=320x320&data=${encodeURIComponent(url)}`;
    }

    function renderTierBadge() {
      if (!tierBadge) return;
      if (userTier === 'premium') {
        tierBadge.className = 'badge-premium rounded-full px-3 py-1 text-xs font-extrabold tracking-wide';
        tierBadge.textContent = 'Premium 👑';
        return;
      }
      tierBadge.className = 'badge-standard rounded-full px-3 py-1 text-xs font-extrabold tracking-wide';
      tierBadge.textContent = 'Standard';
    }

    function handleLogout() {
      localStorage.clear();
      window.location.href = 'login.html';
    }

    if (titleElement) {
      titleElement.textContent = doctorName ? `عيادة ${doctorName}` : 'عيادتي الرقمية';
    }
    renderTierBadge();

    const telegramLink = document.getElementById('telegramLink');
    const whatsappLink = document.getElementById('whatsappLink');
    const telegramQr = document.getElementById('telegramQr');
    const whatsappQr = document.getElementById('whatsappQr');

    if (telegramLink) telegramLink.href = telegramUrl;
    if (whatsappLink) whatsappLink.href = whatsappUrl;
    if (telegramQr) telegramQr.src = buildQrSrc(telegramUrl);
    if (whatsappQr) whatsappQr.src = buildQrSrc(whatsappUrl);

    if (logoutBtn) {
      logoutBtn.addEventListener('click', handleLogout);
    }
  </script>
</body>
</html>
