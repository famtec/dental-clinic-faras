<!doctype html>
<html lang="ar" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>مخزن المواد - عيادتي الرقمية</title>
	<link rel="stylesheet" href="/tailwind.css" />
	<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
	<style>
		body { font-family: 'Tajawal', sans-serif; }
		.panel-soft {
			background: rgba(255, 255, 255, 0.92);
			backdrop-filter: blur(12px);
		}
		.badge-premium {
			background: linear-gradient(130deg, #fef08a 0%, #f59e0b 45%, #fde68a 100%);
			color: #5b3400;
			box-shadow: 0 8px 28px rgba(245, 158, 11, 0.45);
		}
		.badge-standard {
			background: linear-gradient(130deg, #4338ca 0%, #6366f1 100%);
			color: #e0e7ff;
			box-shadow: 0 8px 22px rgba(67, 56, 202, 0.35);
		}
		.upgrade-card-hidden {
			opacity: 0;
			transform: translateY(-8px);
			pointer-events: none;
		}
		.danger-stock {
			background: #ef4444;
			color: #ffffff;
			box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.22), 0 0 24px rgba(239, 68, 68, 0.45);
		}
	</style>
</head>
<body class="min-h-screen overflow-x-hidden bg-[radial-gradient(circle_at_top_left,_rgba(99,102,241,0.22),_transparent_30%),linear-gradient(135deg,_#f8fafc_0%,_#eef2ff_45%,_#e0e7ff_100%)] text-slate-800 transition-opacity duration-300">
	<div class="pointer-events-none absolute inset-0 overflow-hidden">
		<div class="absolute right-[10%] top-16 h-40 w-40 rounded-full bg-indigo-200/30 blur-3xl"></div>
		<div class="absolute left-[6%] top-[22%] h-56 w-56 rounded-full bg-violet-200/20 blur-3xl"></div>
	</div>

	<div id="patientRecordApp" class="relative flex min-h-screen w-full flex-col overflow-x-hidden px-4 pt-24 pb-6 sm:px-6 sm:pt-32 md:pt-32 lg:px-8 lg:pt-32 xl:px-10">
		<header class="fixed inset-x-0 top-0 z-50 hidden w-full border-b border-white/15 bg-[#1e1b4b]/85 shadow-2xl shadow-indigo-950/35 backdrop-blur-2xl md:block">
			<div class="mx-auto flex w-full max-w-none flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8 xl:px-10">
				<div class="flex items-center gap-3 text-white">
					<img id="clinicLogoImg" src="logo.png" alt="شعار العيادة" class="h-12 w-12 rounded-xl border border-white/10 bg-white/10 object-contain p-2 shadow-lg shadow-indigo-950/25" />
					<div class="flex items-center gap-3">
						<h1 id="clinicTitle" class="text-lg font-extrabold tracking-tight text-white sm:text-xl">عيادة الطبيب</h1>
						<span id="tierBadge" class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-extrabold tracking-wide text-white shadow-[0_0_18px_rgba(129,140,248,0.18)]">Standard</span>
					</div>
				</div>

				<div class="flex flex-wrap items-center gap-2 lg:flex-1 lg:justify-center">
					<a href="index.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">👥 لوحة المرضى</a>
					<a href="appointments.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">📅 المواعيد اليومية</a>
					<a href="finance.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">📊 التقارير المالية</a>
					<a href="inventory.html" class="rounded-2xl border border-cyan-300/30 bg-cyan-500/15 px-4 py-2 text-sm font-extrabold text-cyan-50 shadow-[0_0_24px_rgba(34,211,238,0.14)] transition hover:-translate-y-0.5 hover:border-cyan-200/50 hover:bg-cyan-400/20 hover:shadow-[0_0_28px_rgba(34,211,238,0.26)]">📦 مخزن المواد</a>
					<a href="contact_developer.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">🛠️ تواصل مع المطور</a>
					<a href="profile.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cyan-200/40 hover:bg-white/10 hover:shadow-[0_0_24px_rgba(129,140,248,0.18)]">👤 حسابي</a>
					<button id="logoutBtn" type="button" class="rounded-2xl border border-rose-300/30 bg-rose-500/15 px-4 py-2 text-sm font-bold text-rose-100 transition hover:-translate-y-0.5 hover:border-rose-200/50 hover:bg-rose-500/25 hover:shadow-[0_0_24px_rgba(244,63,94,0.18)]">⎋ تسجيل الخروج</button>
				</div>
			</div>
		</header>

		<div class="fixed inset-x-0 top-0 z-[60] border-b border-white/15 bg-[#1e1b4b]/90 shadow-2xl shadow-indigo-950/35 backdrop-blur-2xl md:hidden">
			<div class="relative mx-auto flex w-full max-w-none items-center justify-between gap-3 px-4 py-3 sm:px-6">
				<div class="flex min-w-0 items-center gap-3 text-white">
					<img id="mobileClinicLogoImg" src="logo.png" alt="شعار العيادة" class="h-10 w-10 rounded-xl border border-white/10 bg-white/10 object-contain p-1.5 shadow-lg shadow-indigo-950/25" />
					<div class="min-w-0">
						<div class="flex min-w-0 items-center gap-2">
							<p id="mobileClinicTitle" class="truncate text-sm font-extrabold tracking-tight text-white">عيادة الطبيب</p>
							<span id="mobileTierBadge" class="shrink-0 rounded-full border border-white/15 bg-white/10 px-2 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-[0_0_18px_rgba(129,140,248,0.18)]">Standard</span>
						</div>
					</div>
				</div>

				<button id="mobileMenuToggle" type="button" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-white/15 bg-white/10 text-white shadow-lg shadow-indigo-950/20 transition hover:bg-white/15" aria-expanded="false" aria-controls="mobileMenuDropdown">
					<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M4 7h16"></path>
						<path d="M4 12h16"></path>
						<path d="M4 17h16"></path>
					</svg>
				</button>

				<div id="mobileMenuDropdown" class="absolute left-0 right-0 top-full hidden border-t border-white/10 bg-[#1e1b4b] px-4 py-3 shadow-2xl shadow-indigo-950/35 md:hidden">
					<div class="mx-auto flex w-full max-w-none flex-col gap-2 sm:px-2">
						<a href="index.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">👥 لوحة المرضى</a>
						<a href="appointments.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">📅 المواعيد اليومية</a>
						<a href="finance.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">📊 التقارير المالية</a>
						<a href="inventory.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">📦 مخزن المواد</a>
						<a href="contact_developer.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">🛠️ تواصل مع المطور</a>
						<a href="profile.html" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">👤 حسابي</a>
						<button id="mobileLogoutBtn" type="button" class="rounded-2xl border border-rose-300/30 bg-rose-500/15 px-4 py-3 text-right text-sm font-bold text-rose-100 transition hover:bg-rose-500/25">⎋ تسجيل الخروج</button>
					</div>
				</div>
			</div>
		</div>

		<main class="min-w-0 flex-1 overflow-x-hidden p-4 sm:p-6 lg:p-8 xl:p-10">
			<div id="inventoryLayoutWrapper" class="transition duration-300">
				<section id="inventoryLockedOverlay" class="mb-6 hidden rounded-[28px] border border-indigo-200 bg-gradient-to-br from-indigo-800 via-indigo-700 to-violet-700 p-6 text-white shadow-2xl shadow-indigo-900/35 transition duration-300 sm:p-7">
					<div class="mx-auto max-w-3xl text-center">
						<div class="mb-3 inline-flex rounded-full border border-indigo-200/40 bg-white/10 px-3 py-1 text-xs font-bold tracking-[0.2em] text-indigo-100">PREMIUM PLAN</div>
						<p class="text-lg font-bold leading-8 sm:text-xl">
							إدارة المخزن والمستودع الطبي متاحة حصرياً لمشتركي الباقة الفخمة (Premium). أدخل كود الترقية لتفعيلها فوراً!
						</p>
						<form id="upgradeForm" class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center">
							<input
								id="upgradeCodeInput"
								type="text"
								required
								placeholder="أدخل كود الترقية"
								class="w-full rounded-2xl border border-indigo-200/30 bg-white/90 px-4 py-3 text-right text-sm font-semibold text-slate-800 outline-none transition focus:border-amber-300 focus:ring-4 focus:ring-amber-200 sm:max-w-sm"
							/>
							<button id="upgradeSubmitBtn" type="submit" class="rounded-2xl border border-amber-200/70 bg-gradient-to-r from-amber-300 via-yellow-300 to-amber-400 px-5 py-3 text-sm font-extrabold text-amber-950 shadow-xl shadow-amber-500/30 transition hover:-translate-y-0.5 hover:from-amber-200 hover:to-yellow-300">
								تفعيل الترقية الفورية
							</button>
						</form>
						<p id="upgradeStatus" class="mt-3 text-sm font-semibold text-indigo-100">أدخل الكود ثم اضغط التفعيل.</p>
					</div>
				</section>


				<div id="inventoryBoard" class="space-y-6">
					<section class="panel-soft rounded-[28px] border border-white/70 p-5 shadow-xl shadow-slate-200/70 sm:p-6">
						<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
							<div>
								<div class="inline-flex rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-bold tracking-[0.22em] text-indigo-700">INVENTORY HUB</div>
								<h2 class="mt-3 text-2xl font-extrabold text-slate-800 sm:text-3xl">لوحة إدارة مخزن المواد</h2>
								<p class="mt-1 text-sm text-slate-500">إدارة مخزون العيادة ومتابعة النواقص قبل نفاد المستلزمات.</p>
							</div>
							<span id="inventoryCountBadge" class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">0 عنصر</span>
						</div>
					</section>

					<section class="panel-soft rounded-[28px] border border-white/70 bg-white/90 p-4 shadow-xl shadow-slate-200/70 sm:p-6">
						<div class="mb-4">
							<h3 class="text-xl font-bold text-indigo-900">تسجيل مادة جديدة</h3>
							<p class="mt-1 text-sm text-slate-500">أضف المستحضرات الطبية مع كمية الإنذار الأدنى لتفعيل التنبيه البصري الذكي.</p>
						</div>

						<form id="inventoryForm" class="grid gap-4 md:grid-cols-3">
							<label class="block md:col-span-1">
								<span class="mb-2 block text-sm font-semibold text-slate-700">اسم المادة</span>
								<input id="itemNameInput" type="text" required placeholder="مثال: حشوة كومبوزيت" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" />
							</label>
							<label class="block md:col-span-1">
								<span class="mb-2 block text-sm font-semibold text-slate-700">الكمية الحالية</span>
								<input id="itemQuantityInput" type="number" min="0" required placeholder="25" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" />
							</label>
							<label class="block md:col-span-1">
								<span class="mb-2 block text-sm font-semibold text-slate-700">حد التنبيه الأدنى</span>
								<input id="itemAlertInput" type="number" min="0" required value="5" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" />
							</label>

							<div class="md:col-span-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
								<p id="inventoryStatus" class="text-sm font-medium text-slate-500">جاهز لإضافة عنصر جديد.</p>
								<button id="inventorySubmitBtn" type="submit" class="rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 text-sm font-bold text-white shadow-lg transition hover:from-indigo-700 hover:to-violet-700">
									حفظ المادة في المخزن
								</button>
							</div>
						</form>
					</section>

					<section class="panel-soft rounded-[28px] border border-white/70 bg-white/90 p-4 shadow-xl shadow-slate-200/70 sm:p-6">
						<div class="mb-4 flex items-center justify-between">
							<h3 class="text-xl font-bold text-indigo-900">المخزون الحالي</h3>
							<span class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700">محدث تلقائيًا</span>
						</div>

						<div class="overflow-x-auto rounded-2xl border border-slate-200">
							<table class="min-w-full border-collapse text-right">
								<thead>
									<tr class="border-b border-slate-200 bg-slate-50 text-sm text-slate-600">
										<th class="px-4 py-3 font-semibold">المادة</th>
										<th class="px-4 py-3 font-semibold">الكمية</th>
										<th class="px-4 py-3 font-semibold">حد التنبيه</th>
										<th class="px-4 py-3 font-semibold">آخر تحديث</th>
									</tr>
								</thead>
								<tbody id="inventoryTableBody" class="divide-y divide-slate-100 bg-white text-sm text-slate-700"></tbody>
							</table>
						</div>

						<div id="inventoryEmptyState" class="hidden py-10 text-center text-slate-500">
							لا توجد مواد مخزنية مسجلة حتى الآن.
						</div>
					</section>
				</div>
			</div>

			<footer class="mt-8 text-center text-xs font-mono tracking-wide text-indigo-500/90">
				تطوير وإدارة: المهندس فارس حلاوي © 2026
			</footer>
		</main>
	</div>

	<script src="api-config.js"></script>
	<script src="clinic-loader.js"></script>
	<script>
		let userTier = localStorage.getItem("user_tier");
		// 🔒 حظر فوري ومتزامن لأي زائر لم يسجّل الدخول إطلاقاً -- بدون هذا الفحص كان أي زائر مجهول (وصل مثلاً عبر قائمة تنقل صفحة عامة مثل contact_developer.html) يتجاوز الحماية لأن userTier الفارغ (null) لا يساوي 'pending_activation'، والأخطر أن دوال جلب بيانات المخزن هنا تسقط على بريد الطبيب الاحتياطي الحقيقي عند غياب تسجيل الدخول.
		if (!localStorage.getItem('user_email')) {
			window.location.replace('login.html');
		}
		// 🔒 حظر فوري ومتزامن قبل أي تسجيل لمستمع DOMContentLoaded أو أي طلب Fetch لبيانات محمية -- التوجيه وحده في نهاية الملف لم يكن كافياً.
		if (userTier === 'pending_activation') {
			window.location.replace('index.html');
		}

		// 🔒 قفل التجديد الشهري اللطيف (Soft Paywall) لحساب expired_subscription:
		// غير هدّام عمداً -- ينقل عناصر body الحالية داخل غلاف مموَّه (blur) بدل
		// حذفها، ويضيف نافذة التجديد كعنصر شقيق (وليس ابناً للغلاف) حتى لا يكسر
		// CSS filter تموضعها الثابت (position: fixed) ولا يموّهها هي أيضاً بالخطأ.
		function renderExpiredSubscriptionLock() {
				if (document.getElementById('expiredSubscriptionOverlay')) return;

				const blurWrap = document.createElement('div');
				blurWrap.id = 'expiredBlurWrap';
				blurWrap.style.filter = 'blur(8px)';
				blurWrap.style.pointerEvents = 'none';
				blurWrap.style.userSelect = 'none';
				while (document.body.firstChild) {
						blurWrap.appendChild(document.body.firstChild);
				}
				document.body.appendChild(blurWrap);

				const overlay = document.createElement('div');
				overlay.id = 'expiredSubscriptionOverlay';
				overlay.setAttribute('dir', 'rtl');
				overlay.className = 'fixed inset-0 z-[999] flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 font-sans';
				overlay.innerHTML = `
						<div class="max-w-xl w-full bg-indigo-950/60 backdrop-blur-2xl border border-purple-500/25 p-8 rounded-3xl shadow-2xl shadow-purple-950/60 text-center space-y-6">
								<div class="w-20 h-20 bg-purple-500/10 border border-purple-500/30 rounded-2xl flex items-center justify-center mx-auto text-4xl shadow-lg shadow-purple-500/10 animate-pulse">
								🔒
								</div>

								<h1 class="text-2xl font-bold text-purple-300">انتهت صلاحية باقتك</h1>

								<p class="text-slate-300 leading-relaxed text-sm">
								    مرحباً يا دكتور، نود إعلامك بأن فترة صلاحية باقتك الحالية قد انتهت. سجلات مرضاك، مواعيدك، ومخزن عيادتك في أمان تام ومحفوظة أبدياً داخل السيرفر ولا تضيع أبداً 🔒. للمتابعة الفورية واستعادة صلاحيات الإدارة كاملة، يرجى إدخال كود التجديد الشهري الجديد. للدعم الفني السريع والحصول على الكود كاش، يرجى التواصل مع مطور المنصة المهندس فارس حلاوي على الرقم: 0956907698 🛠️
								</p>

								<div class="space-y-3">
								    <input type="text" id="renewalKeyInput" placeholder="أدخل كود التجديد الجديد هنا"
								           class="w-full bg-slate-900 border border-purple-500/25 rounded-xl px-4 py-3 text-center text-sm focus:outline-none focus:border-purple-400 transition-colors text-white placeholder-slate-500" />

								    <p id="renewalStatusMsg" class="text-xs min-h-[1rem]"></p>

								    <button id="renewSubscriptionBtn" onclick="renewSubscription()"
								            class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold py-3 rounded-xl transition-all shadow-lg shadow-purple-600/30 active:scale-[0.98]">
								        تجديد الاشتراك ومتابعة العمل 🚀
								    </button>
								</div>
						</div>
				`;
				document.body.appendChild(overlay);
		}

		// دالة التحقق من كود التجديد الشهري -- تستدعي نفس مسار /api/activate الموحّد
		// (مسار مزدوج الغرض: يفعّل حساباً جديداً أو يجدّد حساباً منتهياً بنفس المنطق)
		function renewSubscription() {
				const input = document.getElementById('renewalKeyInput');
				const statusEl = document.getElementById('renewalStatusMsg');
				const btn = document.getElementById('renewSubscriptionBtn');
				const keyCode = (input && input.value || '').trim();

				if (!keyCode) {
						if (statusEl) {
								statusEl.textContent = 'يرجى إدخال كود التجديد أولاً.';
								statusEl.className = 'text-xs min-h-[1rem] text-rose-400';
						}
						return;
				}

				if (btn) {
						btn.disabled = true;
						btn.textContent = 'جاري التحقق من الكود...';
				}
				if (statusEl) {
						statusEl.textContent = 'يتم الاتصال بالخادم الآن...';
						statusEl.className = 'text-xs min-h-[1rem] text-indigo-300';
				}

				fetch('/api/activate', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
								email: localStorage.getItem('user_email'),
								activation_key: keyCode,
						}),
				})
						.then(async (res) => {
								let data = null;
								try {
								    data = await res.json();
								} catch (parseError) {
								    data = null;
								}

								if (!res.ok) {
								    const message = (data && data.detail) || 'تعذر التحقق من الكود. حاول مرة أخرى.';
								    if (statusEl) {
								        statusEl.textContent = message;
								        statusEl.className = 'text-xs min-h-[1rem] text-rose-400';
								    }
								    if (btn) {
								        btn.disabled = false;
								        btn.textContent = 'تجديد الاشتراك ومتابعة العمل 🚀';
								    }
								    return;
								}

								localStorage.setItem('user_tier', data.user_tier);
								if (statusEl) {
								    statusEl.textContent = '🎉 تم التجديد بنجاح!';
								    statusEl.className = 'text-xs min-h-[1rem] text-emerald-400';
								}
								// رسالة تهنئة منبثقة فورية حسب الطلب، ثم إعادة تحميل الصفحة مباشرة
								// لإظهار كامل عناصر لوحة التحكم بعد استعادة الصلاحيات.
								alert('🎉 تم تجديد اشتراكك بنجاح! سيتم تحديث الصفحة الآن لإظهار كامل صلاحيات لوحة التحكم.');
								window.location.reload();
						})
						.catch(() => {
								if (statusEl) {
								    statusEl.textContent = 'تعذر الاتصال بالخادم. تحقق من الإنترنت وحاول مرة أخرى.';
								    statusEl.className = 'text-xs min-h-[1rem] text-rose-400';
								}
								if (btn) {
								    btn.disabled = false;
								    btn.textContent = 'تجديد الاشتراك ومتابعة العمل 🚀';
								}
						});
		}

		if (userTier === 'expired_subscription') {
			renderExpiredSubscriptionLock();
		}
		const doctorName = localStorage.getItem('doctor_name') || localStorage.getItem('user_name');
		const doctorEmail = localStorage.getItem('user_email');

		function getInventoryAuthHeaders(extraHeaders = {}) {
			const token = (localStorage.getItem('authToken') || '').trim();
			const headers = { 'X-Doctor-Email': doctorEmail, ...extraHeaders };
			if (token) {
				headers.Authorization = token.startsWith('Bearer ') ? token : `Bearer ${token}`;
			}
			return headers;
		}
		const UPGRADE_ENDPOINT = apiUrl('/api/auth/upgrade-tier');
		const clinicTitle = document.getElementById('clinicTitle');
		const tierBadge = document.getElementById('tierBadge');
		const mobileClinicTitle = document.getElementById('mobileClinicTitle');
		const mobileTierBadge = document.getElementById('mobileTierBadge');
		const mobileMenuToggle = document.getElementById('mobileMenuToggle');
		const mobileMenuDropdown = document.getElementById('mobileMenuDropdown');
		const mobileLogoutBtn = document.getElementById('mobileLogoutBtn');
		const logoutBtn = document.getElementById('logoutBtn');

		const inventoryLayoutWrapper = document.getElementById('inventoryLayoutWrapper');
		const inventoryLockedOverlay = document.getElementById('inventoryLockedOverlay');
		const upgradeForm = document.getElementById('upgradeForm');
		const upgradeCodeInput = document.getElementById('upgradeCodeInput');
		const upgradeSubmitBtn = document.getElementById('upgradeSubmitBtn');
		const upgradeStatus = document.getElementById('upgradeStatus');
		const inventoryBoard = document.getElementById('inventoryBoard');
		const inventoryForm = document.getElementById('inventoryForm');
		const inventoryStatus = document.getElementById('inventoryStatus');
		const inventorySubmitBtn = document.getElementById('inventorySubmitBtn');
		const inventoryCountBadge = document.getElementById('inventoryCountBadge');
		const inventoryTableBody = document.getElementById('inventoryTableBody');
		const inventoryEmptyState = document.getElementById('inventoryEmptyState');

		const itemNameInput = document.getElementById('itemNameInput');
		const itemQuantityInput = document.getElementById('itemQuantityInput');
		const itemAlertInput = document.getElementById('itemAlertInput');

		function handleLogout() {
			localStorage.removeItem('doctor_name');
			localStorage.removeItem('user_email');
			localStorage.removeItem('doctor_id');
			localStorage.removeItem('user_tier');
			window.location.href = 'login.html';
		}

		function renderTierBadge() {
			if (!tierBadge) return;
			if (userTier === 'premium') {
				tierBadge.className = 'badge-premium rounded-full px-3 py-1 text-xs font-extrabold tracking-wide';
				tierBadge.textContent = 'Premium 👑';
				if (mobileTierBadge) {
					mobileTierBadge.className = 'shrink-0 rounded-full border border-emerald-300/30 bg-emerald-400/15 px-2 py-1 text-[11px] font-extrabold tracking-wide text-emerald-50 shadow-[0_0_18px_rgba(52,211,153,0.18)]';
					mobileTierBadge.textContent = 'Premium 👑';
				}
			} else {
				tierBadge.className = 'badge-standard rounded-full px-3 py-1 text-xs font-extrabold tracking-wide';
				tierBadge.textContent = 'Standard';
				if (mobileTierBadge) {
					mobileTierBadge.className = 'shrink-0 rounded-full border border-white/15 bg-white/10 px-2 py-1 text-[11px] font-extrabold tracking-wide text-white shadow-[0_0_18px_rgba(129,140,248,0.18)]';
					mobileTierBadge.textContent = 'Standard';
				}
			}
		}

		function setUpgradeStatus(message, type = 'normal') {
			if (!upgradeStatus) return;
			if (type === 'error') {
				upgradeStatus.className = 'mt-3 text-sm font-semibold text-rose-100';
			} else if (type === 'success') {
				upgradeStatus.className = 'mt-3 text-sm font-semibold text-emerald-200';
			} else {
				upgradeStatus.className = 'mt-3 text-sm font-semibold text-indigo-100';
			}
			upgradeStatus.textContent = message;
		}

		function setInventoryGateState() {
			const isPremium = userTier === 'premium';
			if (isPremium) {
				if (inventoryLockedOverlay) inventoryLockedOverlay.classList.add('hidden');
				if (inventoryBoard) inventoryBoard.classList.remove('pointer-events-none', 'select-none', 'blur-sm', 'opacity-50');
				return true;
			}

			if (inventoryLockedOverlay) inventoryLockedOverlay.classList.remove('hidden');
			if (inventoryBoard) {
				inventoryBoard.classList.add('pointer-events-none', 'select-none', 'blur-sm', 'opacity-50');
			}
			return false;
		}

		async function submitInventoryUpgradeCode(event) {
			event.preventDefault();
			const activationCode = String(upgradeCodeInput?.value || '').trim();

			if (!activationCode) {
				setUpgradeStatus('يرجى إدخال كود الترقية أولاً.', 'error');
				return;
			}

			if (!upgradeSubmitBtn) return;
			upgradeSubmitBtn.disabled = true;
			upgradeSubmitBtn.textContent = 'جاري التحقق...';
			setUpgradeStatus('يتم التحقق من الكود مع الخادم الآن...', 'normal');

			try {
				const storedEmail = String(localStorage.getItem('user_email') || '').trim().toLowerCase();
				const storedDoctorName = String(localStorage.getItem('doctor_name') || '').trim();

				const response = await fetch(UPGRADE_ENDPOINT, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						activation_code: activationCode,
						email: storedEmail || null,
						doctor_name: storedDoctorName || null
					})
				});

				let data = null;
				try {
					data = await response.json();
				} catch (error) {
					data = null;
				}

				if (!response.ok) {
					const safeMessage = data?.detail || data?.message || 'تعذر تفعيل الترقية حالياً. تأكد من الكود ثم أعد المحاولة.';
					setUpgradeStatus(safeMessage, 'error');
					return;
				}

				// لا نحذف أي بيانات مخزون هنا -- الترقية تُحدّث الصلاحية فقط، والبيانات
				// المحفوظة مسبقاً (إن وجدت) تبقى كما هي وتُعرض فور تحديث حالة البوابة.
				localStorage.setItem('user_tier', 'premium');
				if (data?.email) {
					localStorage.setItem('user_email', String(data.email).toLowerCase());
				}
				userTier = 'premium';
				renderTierBadge();
				setUpgradeStatus('تم تفعيل Premium بنجاح. يتم تحديث المخزون الآن...', 'success');

				const canUseInventory = setInventoryGateState();
				if (canUseInventory) {
					await loadInventoryItems();
				}
			} catch (error) {
				setUpgradeStatus('تعذر الاتصال بالخادم أثناء محاولة الترقية.', 'error');
			} finally {
				upgradeSubmitBtn.disabled = false;
				upgradeSubmitBtn.textContent = 'تفعيل الترقية الفورية';
			}
		}

		function escapeHtml(value) {
			return String(value || '')
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;')
				.replaceAll("'", '&#39;');
		}

		function formatDateTime(value) {
			if (!value) return '—';
			const dt = new Date(value);
			if (Number.isNaN(dt.getTime())) return '—';
			return dt.toLocaleString('ar-EG', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
				hour: 'numeric',
				minute: '2-digit',
				hour12: false,
			});
		}

		function updateInventoryCount(count) {
			if (!inventoryCountBadge) return;
			inventoryCountBadge.textContent = `${count} عنصر`;
		}

		function renderInventoryRows(items) {
			if (!inventoryTableBody || !inventoryEmptyState) return;

			const safeItems = Array.isArray(items) ? items : [];
			updateInventoryCount(safeItems.length);

			if (safeItems.length === 0) {
				inventoryTableBody.innerHTML = '';
				inventoryEmptyState.classList.remove('hidden');
				return;
			}

			inventoryEmptyState.classList.add('hidden');
			inventoryTableBody.innerHTML = safeItems.map((item) => {
				const quantity = Number(item?.quantity ?? 0);
				const minAlert = Number(item?.min_alert_quantity ?? 5);
				const isAlert = quantity <= minAlert;
				const quantityBadgeClass = isAlert
					? 'danger-stock rounded-full px-3 py-1 text-xs font-extrabold'
					: 'rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700';

				return `
					<tr class="transition hover:bg-slate-50/80">
						<td class="px-4 py-3 font-semibold text-slate-800">${escapeHtml(item?.item_name)}</td>
						<td class="px-4 py-3"><span class="${quantityBadgeClass}">${escapeHtml(quantity)}</span></td>
						<td class="px-4 py-3 text-slate-600">${escapeHtml(minAlert)}</td>
						<td class="px-4 py-3 text-slate-500">${escapeHtml(formatDateTime(item?.updated_at))}</td>
					</tr>
				`;
			}).join('');
		}

		async function loadInventoryItems() {
			if (userTier !== 'premium') return;
			if (!doctorEmail) {
				if (inventoryStatus) inventoryStatus.textContent = 'تعذر تحديد بريد الطبيب. الرجاء إعادة تسجيل الدخول.';
				return;
			}

			try {
				const response = await fetch(apiUrl('/api/inventory'), {
					method: 'GET',
					headers: getInventoryAuthHeaders(),
				});

				if (!response.ok) {
					const errorText = await response.text();
					throw new Error(errorText || 'تعذر تحميل بيانات المخزن.');
				}

				const items = await response.json();
				renderInventoryRows(items);
			} catch (error) {
				inventoryTableBody.innerHTML = '';
				inventoryEmptyState.classList.remove('hidden');
				if (inventoryStatus) {
					inventoryStatus.textContent = 'تعذر تحميل بيانات المخزن حالياً.';
				}
			}
		}

		async function handleInventorySubmit(event) {
			event.preventDefault();
			if (userTier !== 'premium') return;

			if (!doctorEmail) {
				if (inventoryStatus) inventoryStatus.textContent = 'تعذر تحديد بريد الطبيب. الرجاء إعادة تسجيل الدخول.';
				return;
			}

			const itemName = String(itemNameInput?.value || '').trim();
			const quantity = Number.parseInt(String(itemQuantityInput?.value || ''), 10);
			const minAlert = Number.parseInt(String(itemAlertInput?.value || ''), 10);

			if (!itemName || !Number.isInteger(quantity) || quantity < 0 || !Number.isInteger(minAlert) || minAlert < 0) {
				if (inventoryStatus) inventoryStatus.textContent = 'يرجى إدخال اسم مادة وكمية وحد تنبيه صحيحين.';
				return;
			}

			if (inventorySubmitBtn && window.ClinicLoader) {
				ClinicLoader.setButtonLoading(inventorySubmitBtn, true, { loadingText: '...جاري حفظ المادة' });
			} else if (inventorySubmitBtn) {
				inventorySubmitBtn.disabled = true;
				inventorySubmitBtn.textContent = '...جاري الحفظ';
			}
			if (inventoryStatus) inventoryStatus.textContent = 'جاري حفظ المادة في المخزن...';

			try {
				const response = await fetch(apiUrl('/api/inventory'), {
					method: 'POST',
					headers: getInventoryAuthHeaders({ 'Content-Type': 'application/json' }),
					body: JSON.stringify({
						item_name: itemName,
						quantity,
						min_alert_quantity: minAlert,
					}),
				});

				if (!response.ok) {
					const errorText = await response.text();
					throw new Error(errorText || 'تعذر حفظ المادة.');
				}

				if (inventoryForm) inventoryForm.reset();
				if (itemAlertInput) itemAlertInput.value = '5';
				if (inventoryStatus) inventoryStatus.textContent = 'تم حفظ المادة بنجاح وتحديث لوحة المخزون.';
				await loadInventoryItems();
			} catch (error) {
				if (inventoryStatus) {
					inventoryStatus.textContent = 'فشل حفظ المادة. يرجى المحاولة مرة أخرى.';
				}
			} finally {
				if (inventorySubmitBtn && window.ClinicLoader) {
					ClinicLoader.setButtonLoading(inventorySubmitBtn, false);
				} else if (inventorySubmitBtn) {
					inventorySubmitBtn.disabled = false;
					inventorySubmitBtn.textContent = 'حفظ المادة في المخزن';
				}
			}
		}

		if (logoutBtn) {
			logoutBtn.addEventListener('click', handleLogout);
		}

		if (mobileLogoutBtn) {
			mobileLogoutBtn.addEventListener('click', handleLogout);
		}

		if (mobileMenuToggle && mobileMenuDropdown) {
			mobileMenuToggle.addEventListener('click', () => {
				const isHidden = mobileMenuDropdown.classList.contains('hidden');
				mobileMenuDropdown.classList.toggle('hidden');
				mobileMenuToggle.setAttribute('aria-expanded', String(isHidden));
			});
		}

		if (inventoryForm) {
			inventoryForm.addEventListener('submit', handleInventorySubmit);
		}

		if (upgradeForm) {
			upgradeForm.addEventListener('submit', submitInventoryUpgradeCode);
		}

		window.addEventListener('DOMContentLoaded', async () => {
			// خط دفاع ثانٍ: حتى لو لم يكتمل التوجيه أعلاه بعد، لا نُنفّذ أي
			// إعداد أو جلب بيانات لحساب بانتظار التفعيل.
			const activeGateTier = localStorage.getItem('user_tier');
			if (activeGateTier === 'pending_activation' || activeGateTier === 'expired_subscription') {
				return;
			}
			if (clinicTitle) {
				clinicTitle.textContent = doctorName ? `عيادة ${doctorName}` : 'عيادة الطبيب';
			}
			if (mobileClinicTitle) {
				mobileClinicTitle.textContent = doctorName ? `عيادة ${doctorName}` : 'عيادة الطبيب';
			}
			renderTierBadge();

			const canUseInventory = setInventoryGateState();
			if (canUseInventory) {
				await loadInventoryItems();
			}
		});
		// ملاحظة: تمت إزالة الفحص المكرر الذي كان هنا -- أصبح الحظر يحدث الآن
		// فوراً في أعلى هذا السكربت (انظر تعريف userTier بالأعلى).

	
	function applyDoctorAvatarToHeaderLogo() {
		const avatarUrl = localStorage.getItem('user_avatar_url');
		const logoTargets = [document.getElementById('clinicLogoImg'), document.getElementById('mobileClinicLogoImg')].filter(Boolean);
		if (!avatarUrl) return;
		logoTargets.forEach((img) => {
			// نحفظ الشعار الافتراضي logo.png وأصنافه قبل استبداله بصورة الطبيب، حتى نرجع
			// إليه تلقائياً إن فشل تحميل الصورة (رابط معطوب أو محذوف من التخزين المؤقت
			// على Render) بدل ترك أيقونة صورة مكسورة ظاهرة للزائر (2026-08-25).
			const fallbackSrc = img.getAttribute('src');
			const fallbackClassName = img.className;
			img.onerror = () => {
				img.onerror = null;
				img.src = fallbackSrc;
				img.className = fallbackClassName;
			};
			img.src = window.apiUrl ? apiUrl(avatarUrl) : avatarUrl;
			img.classList.remove('object-contain', 'p-2', 'p-1.5', 'rounded-xl');
			img.classList.add('object-cover', 'rounded-full');
		});
	}

	applyDoctorAvatarToHeaderLogo();
</script>
</body>
</html>
